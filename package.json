{
  "private": true,
  "name": "blink-app",
  "description": "Blink Application",
  "version": "1.0.0",
  "license": "MIT",
  "author": "Dieter Giesler",
  "homepage": "https://exoridus.github.io/blink/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Exoridus/blink.git"
  },
  "type": "module",
  "scripts": {
    "ts-check": "tsc --noEmit",
    "lint": "npm run lint:code && npm run lint:styles",
    "format": "prettier --write .",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "deploy:dev": "node scripts/deploy.ts dev",
    "deploy:live": "node scripts/deploy.ts live",
    "test": "vitest run && npm run test:tooling",
    "blinkfx": "vite-node scripts/blinkfx.ts --",
    "audio-parity": "vite-node scripts/audio-parity.ts --",
    "lint:code": "eslint .",
    "lint:styles": "stylelint \"src/**/*.scss\"",
    "format:check": "node scripts/check-format.ts",
    "test:private": "node scripts/test-private.ts",
    "test:browser": "node scripts/ci-browser-smoke.ts",
    "build:local": "node scripts/build-site.ts local",
    "build:pages": "node scripts/build-site.ts pages",
    "check:builds": "node scripts/check-static-build.ts dist/local / && node scripts/check-static-build.ts dist/pages /blink/",
    "check": "npm run check:policy && npm run format:check && npm run ts-check && npm run lint && npm test && npm run build:local && npm run build:pages && npm run check:builds",
    "prepare": "husky",
    "test:tooling": "node --test scripts/__tests__/node/*.test.ts",
    "check:policy": "node scripts/check-repository-policy.ts",
    "check:commits": "node scripts/check-commits.ts",
    "build:docs": "node scripts/build-docs.ts",
    "test:showcase:browser": "node scripts/test-showcase-browser.ts",
    "export:spec": "node scripts/export-blinkfx-spec.ts",
    "test:showcase:gpu": "node scripts/test-showcase-gpu.ts",
    "test:demo:browser": "node scripts/test-demo-browser.ts"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.19.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@webgpu/types": "^0.1.74",
    "ajv": "^8.20.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.6.0",
    "markdown-it": "^15.0.2",
    "playwright": "^1.64.0",
    "prettier": "^3.9.10",
    "sass": "^1.105.1",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vite-node": "^6.0.0",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "@codexo/exojs": "0.19.1",
    "@codexo/exojs-audio-fx": "0.19.1",
    "fflate": "^0.8.3"
  },
  "engines": {
    "node": "^24.0.0"
  },
  "packageManager": "npm@11.11.0",
  "overrides": {
    "brace-expansion": "^5.0.12",
    "immutable": "^5.1.9"
  }
}
