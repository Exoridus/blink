{
  "Shader": {
    "info": {
      "id": "fixt04",
      "name": "Buffer feedback",
      "username": "blink-fixture",
      "description": "Buffer feedback",
      "tags": ["fixture"],
      "license": "MIT"
    },
    "renderpass": [
      {
        "type": "buffer",
        "name": "Buffer A",
        "code": "void mainImage(out vec4 fragColor, in vec2 fragCoord) {\n  vec2 uv = fragCoord / iResolution.xy;\n  vec2 head = 0.5 + 0.35 * vec2(cos(iTime * 1.3), sin(iTime * 1.7));\n  float dotv = smoothstep(0.03, 0.0, distance(uv, head));\n  fragColor = texture(iChannel0, uv) * 0.97 + vec4(dotv);\n}",
        "inputs": [
          {
            "channel": 0,
            "ctype": "buffer",
            "id": 257,
            "src": "/media/previz/buffer00.png",
            "sampler": {
              "filter": "linear",
              "wrap": "clamp",
              "vflip": "true"
            }
          }
        ],
        "outputs": [
          {
            "channel": 0,
            "id": 257
          }
        ]
      },
      {
        "type": "image",
        "name": "Image",
        "code": "void mainImage(out vec4 fragColor, in vec2 fragCoord) {\n  fragColor = texture(iChannel0, fragCoord / iResolution.xy);\n}",
        "inputs": [
          {
            "channel": 0,
            "ctype": "buffer",
            "id": 257,
            "src": "/media/previz/buffer00.png",
            "sampler": {
              "filter": "linear",
              "wrap": "clamp",
              "vflip": "true"
            }
          }
        ],
        "outputs": []
      }
    ]
  }
}
