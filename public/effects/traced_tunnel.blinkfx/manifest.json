{
  "format": "blinkfx/1",
  "id": "com.codexo.ssf.traced_tunnel",
  "title": "Traced Tunnel",
  "author": "Shane",
  "description": "A multipass reflective box tunnel with some random reflective ray scattering thrown in. Basically, it's just a remake of W23's \"Path Racer\" and NuSan's \"Corridor Travel\" examples.",
  "thumbnail": "thumbnail.png",
  "tags": [
    "3d",
    "realistic",
    "raymarching",
    "tunnel"
  ],
  "kind": "generator",
  "controls": [
    {
      "name": "auto_camera",
      "label": "auto camera",
      "description": "Automatically swing the camera back and forth",
      "group": "camera",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "focused",
      "label": "focused",
      "description": "Remove depth of field for fully focused scene",
      "group": "camera",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "cam_look",
      "label": "cam look",
      "description": "Control where the camera is pointed",
      "group": "camera",
      "type": "point2d",
      "default": [
        0,
        0
      ],
      "min": [
        -1,
        -1
      ],
      "max": [
        1,
        1
      ]
    },
    {
      "name": "FOV",
      "label": "FOV",
      "description": "Field of View of the perspective of the camera",
      "group": "camera",
      "type": "float",
      "default": 1,
      "min": 0.1,
      "max": 3
    },
    {
      "name": "FOV_bump",
      "label": "FOV bump",
      "description": "Quick 'zoom in' field of view hit",
      "group": "camera",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 0.4,
      "step": 0.4
    },
    {
      "name": "scan_x",
      "label": "scan x",
      "description": "Add flashes scanning along X-axis in scene",
      "group": "walls_coloration",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "scan_z",
      "label": "scan z",
      "description": "Add flashes scanning along Z-axis in scene",
      "group": "walls_coloration",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "pixelation",
      "label": "pixelation",
      "description": "Adjust the size of the pixels that form the walls",
      "group": "walls_coloration",
      "type": "float",
      "default": 1,
      "min": 0,
      "max": 3
    },
    {
      "name": "media_scrolling",
      "label": "media scrolling",
      "description": "Whether media that paints the pixel walls is scrolling or not",
      "group": "walls_coloration",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "auto_flasher",
      "label": "auto flasher",
      "description": "Adds flashes to the media on the walls",
      "group": "walls_coloration",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "flat_space",
      "label": "flat space",
      "description": "Remove side walls for a flat plane above and below",
      "group": "geometry",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1
    },
    {
      "name": "rotate_planes",
      "label": "rotate planes",
      "description": "Rotate the planes around the camera",
      "group": "geometry",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 2
    },
    {
      "name": "small_circles",
      "label": "small circles",
      "description": "Make the wall pixels circles instead of squares",
      "group": "geometry",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1.5
    }
  ],
  "inputs": [
    {
      "name": "syn_Media",
      "type": "image",
      "required": false,
      "sampling": {
        "filter": "linear",
        "wrap": "repeat"
      }
    }
  ],
  "assets": [
    {
      "name": "image3",
      "type": "texture2d",
      "path": "assets/3.jpg",
      "sampling": {
        "filter": "mipmap",
        "wrap": "repeat"
      }
    },
    {
      "name": "image48",
      "type": "texture2d",
      "path": "assets/48.jpg",
      "sampling": {
        "filter": "mipmap",
        "wrap": "repeat"
      }
    }
  ],
  "passes": [
    {
      "name": "main",
      "shader": "main",
      "inputs": [
        {
          "source": "asset.image3",
          "uniform": "image3"
        },
        {
          "source": "asset.image48",
          "uniform": "image48"
        },
        {
          "source": "input.syn_Media",
          "uniform": "syn_Media"
        }
      ],
      "target": "screen",
      "clear": true
    }
  ],
  "shaders": {
    "glsl": {
      "main": "shaders/main.frag.glsl"
    }
  },
  "script": {
    "entry": "script.js",
    "abi": "ssf/1"
  },
  "requirements": {
    "features": [
      "script:ssf/1"
    ]
  },
  "compatibility": {
    "source": {
      "format": "ssf",
      "version": "2.0"
    },
    "profile": "ssf/1",
    "mode": "preserve",
    "converter": "blinkfx-ssf-converter/1",
    "controls": {
      "auto_camera": {
        "format": "ssf",
        "type": "toggle",
        "modifiers": []
      },
      "focused": {
        "format": "ssf",
        "type": "toggle smooth",
        "modifiers": [
          "smooth"
        ],
        "params": 0.1
      },
      "cam_look": {
        "format": "ssf",
        "type": "xy smooth",
        "modifiers": [
          "smooth"
        ],
        "params": 0.005
      },
      "FOV": {
        "format": "ssf",
        "type": "slider smooth",
        "modifiers": [
          "smooth"
        ],
        "params": 0.05
      },
      "FOV_bump": {
        "format": "ssf",
        "type": "bang smooth",
        "modifiers": [
          "smooth"
        ],
        "params": 0.075
      },
      "scan_x": {
        "format": "ssf",
        "type": "bang smooth",
        "modifiers": [
          "smooth"
        ],
        "params": 0.2
      },
      "scan_z": {
        "format": "ssf",
        "type": "bang smooth",
        "modifiers": [
          "smooth"
        ],
        "params": 0.02
      },
      "pixelation": {
        "format": "ssf",
        "type": "slider",
        "modifiers": []
      },
      "media_scrolling": {
        "format": "ssf",
        "type": "toggle",
        "modifiers": []
      },
      "auto_flasher": {
        "format": "ssf",
        "type": "toggle",
        "modifiers": []
      },
      "flat_space": {
        "format": "ssf",
        "type": "slider smooth",
        "modifiers": [
          "smooth"
        ],
        "params": 0.04
      },
      "rotate_planes": {
        "format": "ssf",
        "type": "knob smooth",
        "modifiers": [
          "smooth"
        ],
        "params": 0.04
      },
      "small_circles": {
        "format": "ssf",
        "type": "knob smooth",
        "modifiers": [
          "smooth"
        ],
        "params": 0.1
      }
    }
  },
  "license": "Third-party preview: original authors retain all rights; see the author field and source/ directory. Not relicensed by Blink."
}
