{
  "format": "blinkfx/1",
  "id": "com.codexo.ssf.sinusoidal_warp",
  "title": "Sinusoidal Warp",
  "author": "Shady Headstash",
  "description": "Sinusoidal warp.",
  "thumbnail": "thumbnail.png",
  "tags": [
    "media",
    "uv",
    "distorted"
  ],
  "kind": "generator",
  "controls": [
    {
      "name": "rate",
      "label": "rate",
      "description": "Rate of the effect.",
      "group": "effect",
      "type": "float",
      "default": 0.25,
      "min": 0,
      "max": 1
    },
    {
      "name": "warp",
      "label": "warp",
      "description": "Warpiness of the effect.",
      "group": "effect",
      "type": "float",
      "default": 4,
      "min": 1,
      "max": 8
    },
    {
      "name": "intensity",
      "label": "intensity",
      "description": "How dramatically the effect modifies the input media.",
      "group": "effect",
      "type": "float",
      "default": 1,
      "min": 0,
      "max": 1
    },
    {
      "name": "direction",
      "label": "direction",
      "description": "Nudge effect in any direction.",
      "group": "effect",
      "type": "point2d",
      "default": [
        1,
        1
      ],
      "min": [
        1,
        1
      ],
      "max": [
        1,
        1
      ]
    },
    {
      "name": "media_xy",
      "label": "media xy",
      "description": "Pan input media in any direction.",
      "group": "media",
      "type": "point2d",
      "default": [
        0,
        0
      ],
      "min": [
        -1,
        -1
      ],
      "max": [
        1,
        1
      ]
    },
    {
      "name": "refraction",
      "label": "refraction",
      "description": "Amount of refraction of the input media.",
      "group": "effect",
      "type": "float",
      "default": 0.25,
      "min": 0,
      "max": 1
    },
    {
      "name": "brightness",
      "label": "brightness",
      "description": "Brightness of lighting and density of shadows.",
      "group": "effect",
      "type": "float",
      "default": 0.5,
      "min": 0,
      "max": 1
    }
  ],
  "inputs": [
    {
      "name": "syn_Media",
      "type": "image",
      "required": false,
      "sampling": {
        "filter": "linear",
        "wrap": "repeat"
      }
    }
  ],
  "passes": [
    {
      "name": "main",
      "shader": "main",
      "inputs": [
        {
          "source": "input.syn_Media",
          "uniform": "syn_Media"
        }
      ],
      "target": "screen",
      "clear": true
    }
  ],
  "shaders": {
    "glsl": {
      "main": "shaders/main.frag.glsl"
    }
  },
  "script": {
    "entry": "script.js",
    "abi": "ssf/1"
  },
  "requirements": {
    "features": [
      "script:ssf/1"
    ]
  },
  "compatibility": {
