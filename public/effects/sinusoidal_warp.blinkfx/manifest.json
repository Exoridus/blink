        "modifiers": [
          "smooth"
        ],
        "params": 0.01
      },
      "refraction": {
        "format": "ssf",
        "type": "slider smooth",
        "modifiers": [
          "smooth"
        ],
        "params": 0.1
      },
      "brightness": {
        "format": "ssf",
        "type": "slider smooth",
        "modifiers": [
          "smooth"
        ],
        "params": 0.01
      }
    },
    "scriptUniforms": {
      "bass_time": "float"
