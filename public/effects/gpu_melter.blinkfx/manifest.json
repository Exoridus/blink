{
  "format": "blinkfx/1",
  "id": "com.codexo.ssf.gpu_melter",
  "title": "GPU_Melter",
  "author": "Meebs",
  "thumbnail": "thumbnail.jpg",
  "tags": [
    "3d",
    "raymarching",
    "dark",
    "glitchy",
    "media"
  ],
  "kind": "generator",
  "controls": [
    {
      "name": "flashing",
      "label": "flashing",
      "description": "Turn ON to cause the scene to flash on high percussive hits.",
      "group": "color",
      "type": "float",
      "default": 1,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "monochrome",
      "label": "monochrome",
      "description": "Turn ON to force the scene to monochrome, which also effects the visual feedback. Try with a Media (and try inverting the image).",
      "group": "color",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "extra_cols",
      "label": "extra cols",
      "description": "Turn ON to add in extra colors to any of the color palettes. Results in more saturated, noisy colors.",
      "group": "color",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "pixelation",
      "label": "pixelation",
      "description": "Default is none. Increase this slider for a pixelation effect.",
      "group": "feedback",
      "type": "float",
      "default": 500,
      "min": 500,
      "max": 500
    },
    {
      "name": "feedback",
      "label": "feedback",
      "description": "Turn up to increase the 'overload' feedback moments. Turn down to turn off overloaded feedback entirely.",
      "group": "feedback",
      "type": "float",
      "default": 1,
      "min": 0.5,
      "max": 3
    },
    {
      "name": "auto_blocks",
      "label": "auto blocks",
      "description": "Turn ON to automatically have large blocky pixels change on beat.",
      "group": "background",
      "type": "float",
      "default": 1,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "fresh_blocks",
      "label": "fresh blocks",
      "description": "Manually force blocks to change on press.",
      "group": "background",
      "type": "float",
      "default": 1,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "bkgColSel",
      "label": "bkgColSel",
      "type": "float",
      "default": 0,
      "group": "Transitions"
    },
    {
      "name": "faceZoom",
      "label": "faceZoom",
      "type": "float",
      "default": 0.2,
      "group": "Transitions"
    }
  ],
  "inputs": [
    {
      "name": "syn_UserImage",
      "type": "image",
      "required": false,
      "sampling": {
        "filter": "linear",
        "wrap": "repeat"
      }
    }
  ],
  "passes": [
    {
      "name": "face",
      "shader": "main",
      "inputs": [
        {
          "source": "target.face.previous",
          "uniform": "face"
        },
        {
          "source": "target.forBlur.previous",
          "uniform": "forBlur"
        },
        {
          "source": "input.syn_UserImage",
          "uniform": "syn_UserImage"
        }
      ],
      "target": {
        "name": "face",
        "format": "rgba8",
        "sampling": {
          "filter": "linear",
          "wrap": "repeat"
        },
        "persistent": true
      },
      "clear": false
    },
    {
      "name": "forBlur",
      "shader": "main",
      "inputs": [
        {
          "source": "target.face",
          "uniform": "face"
        },
        {
          "source": "target.forBlur.previous",
          "uniform": "forBlur"
        },
        {
          "source": "input.syn_UserImage",
          "uniform": "syn_UserImage"
        }
      ],
      "target": {
        "name": "forBlur",
        "format": "rgba32f",
        "sampling": {
          "filter": "linear",
          "wrap": "repeat"
        },
        "persistent": true
      },
      "clear": false
    },
    {
      "name": "final",
      "shader": "main",
      "inputs": [
        {
          "source": "target.face",
          "uniform": "face"
        },
        {
          "source": "target.forBlur",
          "uniform": "forBlur"
        },
        {
          "source": "input.syn_UserImage",
          "uniform": "syn_UserImage"
        }
      ],
      "target": "screen",
      "clear": true
    }
  ],
  "shaders": {
    "glsl": {
      "main": "shaders/main.frag.glsl"
    }
  },
  "compatibility": {
    "source": {
      "format": "ssf",
      "version": "2.0"
    },
    "profile": "ssf/1",
    "mode": "preserve",
    "converter": "blinkfx-ssf-converter/1",
    "controls": {
      "flashing": {
        "format": "ssf",
        "type": "toggle",
        "modifiers": []
      },
      "monochrome": {
        "format": "ssf",
        "type": "toggle",
        "modifiers": []
      },
      "extra_cols": {
        "format": "ssf",
        "type": "toggle",
        "modifiers": []
      },
      "pixelation": {
        "format": "ssf",
        "type": "slider",
        "modifiers": []
      },
      "feedback": {
        "format": "ssf",
        "type": "slider",
        "modifiers": []
      },
      "auto_blocks": {
        "format": "ssf",
        "type": "toggle",
        "modifiers": []
      },
      "fresh_blocks": {
        "format": "ssf",
        "type": "bang counter",
        "modifiers": [
          "counter"
        ]
      }
    }
  },
  "license": "Third-party preview: original authors retain all rights; see the author field and source/ directory. Not relicensed by Blink."
}
