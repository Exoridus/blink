  "inputs": [
    {
      "name": "syn_Media",
      "type": "image",
      "required": false,
      "sampling": {
        "filter": "linear",
        "wrap": "mirror"
      }
    }
  ],
  "passes": [
    {
      "name": "pass0",
      "shader": "main",
      "inputs": [
        {
          "source": "target.pass0.previous",
          "uniform": "pass0"
        },
        {
          "source": "target.pass1.previous",
          "uniform": "pass1"
        },
        {
          "source": "blink.audio.spectrum",
          "uniform": "syn_Spectrum"
        },
        {
          "source": "input.syn_Media",
          "uniform": "syn_Media"
        }
      ],
      "target": {
        "name": "pass0",
        "width": 1920,
        "height": 1080,
        "format": "rgba32f",
        "sampling": {
          "filter": "linear",
          "wrap": "repeat"
        },
        "persistent": true
      },
      "clear": false
    },
    {
      "name": "pass1",
      "shader": "main",
      "inputs": [
        {
          "source": "target.pass0",
          "uniform": "pass0"
        },
        {
          "source": "target.pass1.previous",
          "uniform": "pass1"
        },
        {
          "source": "blink.audio.spectrum",
          "uniform": "syn_Spectrum"
        },
        {
          "source": "input.syn_Media",
          "uniform": "syn_Media"
        }
      ],
      "target": {
        "name": "pass1",
        "width": 1920,
        "height": 1080,
        "format": "rgba32f",
        "sampling": {
          "filter": "linear",
          "wrap": "repeat"
        },
        "persistent": true
      },
      "clear": false
    },
    {
      "name": "final",
      "shader": "main",
      "inputs": [
        {
          "source": "target.pass0",
          "uniform": "pass0"
        },
        {
          "source": "target.pass1",
          "uniform": "pass1"
        },
        {
          "source": "blink.audio.spectrum",
          "uniform": "syn_Spectrum"
        },
        {
          "source": "input.syn_Media",
          "uniform": "syn_Media"
        }
      ],
      "target": "screen",
      "clear": true
    }
  ],
  "shaders": {
    "glsl": {
      "main": "shaders/main.frag.glsl"
