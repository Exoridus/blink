{
  "format": "blinkfx/1",
  "id": "com.codexo.ssf.replik8",
  "title": "replik8",
  "author": "Meebs",
  "thumbnail": "thumbnail.png",
  "tags": [
    "2d",
    "geometric",
    "grayscale",
    "media"
  ],
  "kind": "generator",
  "controls": [
    {
      "name": "circle_or_tri",
      "label": "circle or tri",
      "group": "geometry",
      "type": "float",
      "default": 1,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "distort",
      "label": "distort",
      "group": "geometry",
      "type": "float",
      "default": 0,
      "min": -0.2,
      "max": 0.2
    },
    {
      "name": "layers_on",
      "label": "layers on",
      "group": "layers",
      "type": "float",
      "default": 1,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "twist",
      "label": "twist",
      "group": "layers",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "flashing",
      "label": "flashing",
      "group": "layers",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "power_zoom",
      "label": "power zoom",
      "group": "layers",
      "type": "float",
      "default": 0.2,
      "min": 0,
      "max": 1
    },
    {
      "name": "media_on",
      "label": "media on",
      "description": "Use this scene with Media!",
      "group": "media",
      "type": "float",
      "default": 1,
      "min": 0,
      "max": 1,
      "step": 1
    }
  ],
  "inputs": [
    {
      "name": "syn_Media",
      "type": "image",
      "required": false,
      "sampling": {
        "filter": "linear",
        "wrap": "repeat"
      }
    }
  ],
  "assets": [
    {
      "name": "colornoise",
      "type": "texture2d",
      "path": "assets/colornoise.jpg",
      "sampling": {
        "filter": "mipmap",
        "wrap": "repeat"
      }
    }
  ],
  "passes": [
    {
      "name": "backbuffer",
      "shader": "main",
      "inputs": [
        {
          "source": "target.backbuffer.previous",
          "uniform": "backbuffer"
        },
        {
          "source": "input.syn_Media",
          "uniform": "syn_Media"
        }
      ],
      "target": {
        "name": "backbuffer",
        "width": 1280,
        "height": 720,
        "format": "rgba32f",
        "sampling": {
          "filter": "linear",
          "wrap": "repeat"
        },
        "persistent": true
      },
      "clear": false
    },
    {
      "name": "final",
      "shader": "main",
      "inputs": [
        {
          "source": "target.backbuffer",
          "uniform": "backbuffer"
        },
        {
          "source": "input.syn_Media",
          "uniform": "syn_Media"
        }
      ],
      "target": "screen",
      "clear": true
    }
  ],
  "shaders": {
    "glsl": {
      "main": "shaders/main.frag.glsl"
    }
  },
  "compatibility": {
    "source": {
      "format": "ssf",
      "version": "2.0"
    },
    "profile": "ssf/1",
    "mode": "preserve",
    "converter": "blinkfx-ssf-converter/1",
    "controls": {
      "circle_or_tri": {
        "format": "ssf",
        "type": "toggle smooth",
        "modifiers": [
          "smooth"
        ],
        "params": 0.1
      },
      "distort": {
        "format": "ssf",
        "type": "slider smooth",
        "modifiers": [
          "smooth"
        ],
        "params": 0.1
      },
      "layers_on": {
        "format": "ssf",
        "type": "toggle smooth",
        "modifiers": [
          "smooth"
        ],
        "params": 0.1
      },
      "twist": {
        "format": "ssf",
        "type": "toggle smooth",
        "modifiers": [
          "smooth"
        ],
        "params": 0.01
      },
      "flashing": {
        "format": "ssf",
        "type": "toggle",
        "modifiers": []
      },
      "power_zoom": {
        "format": "ssf",
        "type": "slider smooth",
        "modifiers": [
          "smooth"
        ],
        "params": 0.01
      },
      "media_on": {
        "format": "ssf",
        "type": "toggle smooth",
        "modifiers": [
          "smooth"
        ],
        "params": 0.2
      }
    }
  },
  "license": "Third-party preview: original authors retain all rights; see the author field and source/ directory. Not relicensed by Blink."
}
