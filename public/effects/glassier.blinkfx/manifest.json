{
  "format": "blinkfx/1",
  "id": "com.codexo.ssf.glassier",
  "title": "Glassier",
  "author": "Felix Woitzel",
  "tags": [
    "simulation",
    "dark",
    "reaction-diffusion",
    "media"
  ],
  "kind": "generator",
  "controls": [
    {
      "name": "shock_back",
      "label": "shock back",
      "description": "Click to pull the simulation backwards a bit, or click many times to completely black it out and let it pour forward at the right moment.",
      "group": "shock",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "shock_forward",
      "label": "shock forward",
      "description": "Push the simulation forward, dulling it out a bit in the process.",
      "group": "shock",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "image_block",
      "label": "image block",
      "description": "Choose whether the image should be a hard boundary in the simulation (ON) or have a subtle effect (OFF).",
      "group": "general",
      "type": "float",
      "default": 1,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "color_inv",
      "label": "color inv",
      "description": "ON Allows dark parts of the simulation to be filled in with inverted colors rather than just black.",
      "group": "general",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "auto_position",
      "label": "auto position",
      "description": "Let the stirrer move around the screen constantly, or turn off to take manual control.",
      "group": "position",
      "type": "float",
      "default": 1,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "manual_position",
      "label": "manual position",
      "description": "auto position MUST BE SET TO OFF. Manually set the position of the 'stirrer'.",
      "group": "position",
      "type": "point2d",
      "default": [
        0,
        0
      ],
      "min": [
        -0.8,
        -0.8
      ],
      "max": [
        0.8,
        0.8
      ]
    },
    {
      "name": "auto_impulse",
      "label": "auto impulse",
      "description": "Choose whether impulses should happen automatically (ON) or only on your manual command.",
      "group": "impulse",
      "type": "float",
      "default": 1,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "manual_impulse",
      "label": "manual impulse",
      "description": "Manually cause the stirrer to receive an impulse. Depends on 'motion mode', 'manual position' and 'impulse power'.",
      "group": "impulse",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "impulse_power",
      "label": "impulse power",
      "description": "Choose how powerful the automatic and manual impulses are.",
      "group": "impulse",
      "type": "float",
      "default": 1,
      "min": 0,
      "max": 2
    },
    {
      "name": "motion_mode",
      "label": "motion mode",
      "description": "Choose whether the stirrer creates vortices on high hits (OFF) or pushes the fluid up on bass hits (ON).",
      "group": "motion",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "in_out",
      "label": "in out",
      "description": "Cause the simulation to slowly move inwards or outwards based on the position of the slider. Centered is zero. Careful when maxing out upward, if there is no User Image feeding it, you could kill the simulation and you'd have to restart the scene.",
      "group": "motion",
      "type": "float",
      "default": 0,
      "min": -5,
      "max": 5
    },
    {
      "name": "cReg4",
      "label": "cReg4",
      "type": "float",
      "default": 1,
      "group": "Transitions"
    },
    {
      "name": "cReg0",
      "label": "cReg0",
      "type": "float",
      "default": 0,
      "group": "Transitions"
    },
    {
      "name": "cReg2",
      "label": "cReg2",
      "type": "float",
      "default": 0,
      "group": "Transitions"
    },
    {
      "name": "cReg3",
      "label": "cReg3",
      "type": "float",
      "default": 0,
      "group": "Transitions"
    },
    {
      "name": "cReg1",
      "label": "cReg1",
      "type": "float",
      "default": 0,
      "group": "Transitions"
    }
  ],
  "inputs": [
    {
      "name": "syn_UserImage",
      "type": "image",
      "required": false,
      "sampling": {
        "filter": "linear",
        "wrap": "repeat"
      }
    }
  ],
  "passes": [
    {
      "name": "buffA",
      "shader": "main",
      "inputs": [
        {
          "source": "target.buffA.previous",
          "uniform": "buffA"
        },
        {
          "source": "target.buffB.previous",
          "uniform": "buffB"
        },
        {
          "source": "target.buffC.previous",
          "uniform": "buffC"
        },
        {
          "source": "input.syn_UserImage",
          "uniform": "syn_UserImage"
        }
      ],
      "target": {
        "name": "buffA",
        "width": 1600,
        "height": 900,
        "format": "rgba32f",
        "sampling": {
          "filter": "linear",
          "wrap": "repeat"
        },
        "persistent": true
      },
      "clear": false
    },
    {
      "name": "buffB",
      "shader": "main",
      "inputs": [
        {
          "source": "target.buffA",
          "uniform": "buffA"
        },
        {
          "source": "target.buffB.previous",
          "uniform": "buffB"
        },
        {
          "source": "target.buffC.previous",
          "uniform": "buffC"
        },
        {
          "source": "input.syn_UserImage",
          "uniform": "syn_UserImage"
        }
      ],
      "target": {
        "name": "buffB",
        "width": 1600,
        "height": 900,
        "format": "rgba32f",
        "sampling": {
          "filter": "linear",
          "wrap": "repeat"
        },
        "persistent": true
      },
      "clear": false
    },
    {
      "name": "buffC",
      "shader": "main",
      "inputs": [
        {
          "source": "target.buffA",
          "uniform": "buffA"
        },
        {
          "source": "target.buffB",
          "uniform": "buffB"
        },
        {
          "source": "target.buffC.previous",
          "uniform": "buffC"
        },
        {
          "source": "input.syn_UserImage",
          "uniform": "syn_UserImage"
        }
      ],
      "target": {
        "name": "buffC",
        "width": 1600,
        "height": 900,
        "format": "rgba32f",
        "sampling": {
          "filter": "linear",
          "wrap": "repeat"
        },
        "persistent": true
      },
      "clear": false
    },
    {
      "name": "final",
      "shader": "main",
      "inputs": [
        {
          "source": "target.buffA",
          "uniform": "buffA"
        },
        {
          "source": "target.buffB",
          "uniform": "buffB"
        },
        {
          "source": "target.buffC",
          "uniform": "buffC"
        },
        {
          "source": "input.syn_UserImage",
          "uniform": "syn_UserImage"
        }
      ],
      "target": "screen",
      "clear": true
    }
  ],
  "shaders": {
    "glsl": {
      "main": "shaders/main.frag.glsl"
    }
  },
  "compatibility": {
    "source": {
      "format": "ssf",
      "version": "2.0"
    },
    "profile": "ssf/1",
    "mode": "preserve",
    "converter": "blinkfx-ssf-converter/1",
    "controls": {
      "shock_back": {
        "format": "ssf",
        "type": "bang smooth",
        "modifiers": [
          "smooth"
        ],
        "params": 0.01
      },
      "shock_forward": {
        "format": "ssf",
        "type": "bang smooth",
        "modifiers": [
          "smooth"
        ],
        "params": 0.2
      },
      "image_block": {
        "format": "ssf",
        "type": "toggle",
        "modifiers": []
      },
      "color_inv": {
        "format": "ssf",
        "type": "toggle",
        "modifiers": []
      },
      "auto_position": {
        "format": "ssf",
        "type": "toggle",
        "modifiers": []
      },
      "manual_position": {
        "format": "ssf",
        "type": "xy smooth",
        "modifiers": [
          "smooth"
        ],
        "params": 0.05
      },
      "auto_impulse": {
        "format": "ssf",
        "type": "toggle",
        "modifiers": []
      },
      "manual_impulse": {
        "format": "ssf",
        "type": "bang smooth",
        "modifiers": [
          "smooth"
        ],
        "params": 0.095
      },
      "impulse_power": {
        "format": "ssf",
        "type": "slider",
        "modifiers": []
      },
      "motion_mode": {
        "format": "ssf",
        "type": "toggle",
        "modifiers": []
      },
      "in_out": {
        "format": "ssf",
        "type": "slider",
        "modifiers": []
      }
    }
  },
  "license": "Third-party preview: original authors retain all rights; see the author field and source/ directory. Not relicensed by Blink."
}
