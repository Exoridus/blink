{
  "format": "blinkfx/1",
  "id": "com.codexo.ssf.swarm",
  "title": "Swarm",
  "author": "Meebs",
  "thumbnail": "thumbnail.png",
  "tags": [
    "media",
    "particles",
    "colorful",
    "retro"
  ],
  "kind": "generator",
  "controls": [
    {
      "name": "run_away",
      "label": "run away",
      "description": "The point they'll run from, if fear is set to ON.",
      "group": "fear",
      "type": "point2d",
      "default": [
        0,
        0
      ],
      "min": [
        0,
        0
      ],
      "max": [
        1.2,
        1.2
      ]
    },
    {
      "name": "fear_on",
      "label": "fear on",
      "group": "fear",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 2,
      "step": 2
    },
    {
      "name": "frantic",
      "label": "frantic",
      "group": "motion",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "energize_center",
      "label": "energize center",
      "group": "motion",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "calm_collect",
      "label": "calm collect",
      "group": "motion",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "excitement",
      "label": "excitement",
      "description": "Higher excitement just means more exaggerated motion.",
      "group": "motion",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 3
    },
    {
      "name": "color_pop",
      "label": "color pop",
      "group": "color",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "color_palette",
      "label": "color palette",
      "group": "color",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "invert_col",
      "label": "invert col",
      "group": "color",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "size",
      "label": "size",
      "group": "color",
      "type": "float",
      "default": 0.6,
      "min": 0,
      "max": 3
    },
    {
      "name": "twitcherType",
      "label": "twitcherType",
      "type": "float",
      "default": 0,
      "group": "Transitions"
    },
    {
      "name": "twitchForceSupplier",
      "label": "twitchForceSupplier",
      "type": "float",
      "default": 0,
      "group": "Transitions"
    }
  ],
  "inputs": [
    {
      "name": "syn_Media",
      "type": "image",
      "required": false,
      "sampling": {
        "filter": "linear",
        "wrap": "repeat"
      }
    }
  ],
  "passes": [
    {
      "name": "firstBuffer",
      "shader": "main",
      "inputs": [
        {
          "source": "target.firstBuffer.previous",
          "uniform": "firstBuffer"
        },
        {
          "source": "target.secondBuffer.previous",
          "uniform": "secondBuffer"
        },
        {
          "source": "input.syn_Media",
          "uniform": "syn_Media"
        }
      ],
      "target": {
        "name": "firstBuffer",
        "width": 100,
        "height": 2,
        "format": "rgba32f",
        "sampling": {
          "filter": "linear",
          "wrap": "repeat"
        },
        "persistent": true
      },
      "clear": false
    },
    {
      "name": "secondBuffer",
      "shader": "main",
      "inputs": [
        {
          "source": "target.firstBuffer",
          "uniform": "firstBuffer"
        },
        {
          "source": "target.secondBuffer.previous",
          "uniform": "secondBuffer"
        },
        {
          "source": "input.syn_Media",
          "uniform": "syn_Media"
        }
      ],
      "target": {
        "name": "secondBuffer",
        "width": 1200,
        "height": 720,
        "format": "rgba32f",
        "sampling": {
          "filter": "linear",
          "wrap": "repeat"
        },
        "persistent": true
      },
      "clear": false
    },
    {
      "name": "final",
      "shader": "main",
      "inputs": [
        {
          "source": "target.firstBuffer",
          "uniform": "firstBuffer"
        },
        {
          "source": "target.secondBuffer",
          "uniform": "secondBuffer"
        },
        {
          "source": "input.syn_Media",
          "uniform": "syn_Media"
        }
      ],
      "target": "screen",
      "clear": true
    }
  ],
  "shaders": {
    "glsl": {
      "main": "shaders/main.frag.glsl"
    }
  },
  "compatibility": {
    "source": {
      "format": "ssf",
      "version": "2.0"
    },
    "profile": "ssf/1",
    "mode": "preserve",
    "converter": "blinkfx-ssf-converter/1",
    "controls": {
      "run_away": {
        "format": "ssf",
        "type": "xy",
        "modifiers": []
      },
      "fear_on": {
        "format": "ssf",
        "type": "toggle",
        "modifiers": []
      },
      "frantic": {
        "format": "ssf",
        "type": "toggle",
        "modifiers": []
      },
      "energize_center": {
        "format": "ssf",
        "type": "toggle",
        "modifiers": []
      },
      "calm_collect": {
        "format": "ssf",
        "type": "toggle",
        "modifiers": []
      },
      "excitement": {
        "format": "ssf",
        "type": "slider smooth",
        "modifiers": [
          "smooth"
        ],
        "params": 0.1
      },
      "color_pop": {
        "format": "ssf",
        "type": "bang smooth",
        "modifiers": [
          "smooth"
        ],
        "params": 0.5
      },
      "color_palette": {
        "format": "ssf",
        "type": "bang counter",
        "modifiers": [
          "counter"
        ]
      },
      "invert_col": {
        "format": "ssf",
        "type": "toggle",
        "modifiers": []
      },
      "size": {
        "format": "ssf",
        "type": "slider",
        "modifiers": []
      }
    }
  },
