float _pulse(float variable, float center, float width){
  return (smoothstep(center-width, center, variable)-(smoothstep(center, center+width, variable)));
}

vec3 _rgb2hsv(vec3 c) {
  vec4 K = vec4(0.0, -1.0 / 3.0, 2.0 / 3.0, -1.0);
  vec4 p = mix(vec4(c.bg, K.wz), vec4(c.gb, K.xy), step(c.b, c.g));
  vec4 q = mix(vec4(p.xyw, c.r), vec4(c.r, p.yzx), step(p.x, c.r));
  float d = q.x - min(q.w, q.y);
  float e = 1.0e-10;
  return vec3(abs(q.z + (q.w - q.y) / (6.0 * d + e)), d / (q.x + e), q.x);
}

vec3 _hsv2rgb(vec3 c) {
  vec4 K = vec4(1.0, 2.0 / 3.0, 1.0 / 3.0, 3.0);
  vec3 p = abs(fract(c.xxx + K.xyz) * 6.0 - K.www);
  return c.z * mix(K.xxx, clamp(p - K.xxx, 0.0, 1.0), c.y);
}

vec4 _hueSaturation(vec4 color, float hue, float saturation){
  color.rgb = _rgb2hsv(clamp(color.rgb, 0.0, 1.0));
  color.r = color.r+hue;
  color.g = clamp(color.g*(saturation*abs(saturation)*2.5+1.0), 0.0, 1.0);
  color.rgb = _hsv2rgb(color.rgb);
  return color;
}

vec3 _contrast(vec3 color, float contrast) {
  color = (color - 0.5) * contrast + 0.5;
  return color;
}
vec4 _contrast(vec4 color, float contrast) {
  color.rgb = _contrast(color.rgb, contrast);
  return color;
}

vec4 _applyContrast(vec4 color) {
  float contrast = _Contrast;
  if (contrast > 1.0) contrast *= contrast;
  return _contrast(color, contrast);
}

vec4 _hueSaturationLEGACY(vec4 color, float hue, float saturation){
