float fbm2(vec2 p) {
  float
    a=0.
  , aa=1.
  , i
  , d=0.
  ;

  for (i=0.;i<3.;++i) {
    a+=aa*sin(p.x);
    d+=aa;
    aa*=.5;
    p*=mat2(6.0,8.0,-8.0,6.0)/5.;
    p+=1.234;
  }

  return a/d;
}

