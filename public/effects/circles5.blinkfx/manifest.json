{
  "format": "blinkfx/1",
  "id": "com.codexo.ssf.circles5",
  "title": "Circles5",
  "author": "Keijiro Takahashi",
  "thumbnail": "thumbnail.png",
  "tags": [
    "2d",
    "grayscale",
    "feedback",
    "media",
    "dark"
  ],
  "kind": "generator",
  "controls": [
    {
      "name": "rain",
      "label": "rain",
      "group": "effects",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "pop",
      "label": "pop",
      "group": "effects",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 0.2,
      "step": 0.2
    },
    {
      "name": "feedback_on",
      "label": "feedback on",
      "group": "feedback",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 0.9,
      "step": 0.9
    },
    {
      "name": "feedback_warp",
      "label": "feedback warp",
      "group": "feedback",
      "type": "float",
      "default": 0.05,
      "min": 0,
      "max": 0.1
    },
    {
      "name": "speed_",
      "label": "speed ",
      "group": "time",
      "type": "float",
      "default": 0.8,
      "min": 0,
      "max": 1.5
    },
    {
      "name": "reverse",
      "label": "reverse",
      "group": "time",
      "type": "float",
      "default": 1,
      "min": 1,
      "max": 1,
      "step": 1
    }
  ],
  "inputs": [
    {
      "name": "syn_Media",
      "type": "image",
      "required": false,
      "sampling": {
        "filter": "linear",
        "wrap": "repeat"
      }
    }
  ],
  "passes": [
    {
      "name": "firstBuffer",
      "shader": "main",
      "inputs": [
        {
          "source": "target.firstBuffer.previous",
          "uniform": "firstBuffer"
        },
        {
          "source": "input.syn_Media",
          "uniform": "syn_Media"
        }
      ],
      "target": {
        "name": "firstBuffer",
        "format": "rgba32f",
        "sampling": {
          "filter": "linear",
          "wrap": "repeat"
        },
        "persistent": true
      },
      "clear": false
    },
    {
      "name": "final",
      "shader": "main",
      "inputs": [
        {
          "source": "target.firstBuffer",
          "uniform": "firstBuffer"
        },
        {
          "source": "input.syn_Media",
          "uniform": "syn_Media"
        }
      ],
      "target": "screen",
      "clear": true
    }
  ],
  "shaders": {
    "glsl": {
      "main": "shaders/main.frag.glsl"
    }
  },
  "script": {
    "entry": "script.js",
    "abi": "ssf/1"
  },
  "requirements": {
    "features": [
      "script:ssf/1"
    ]
  },
  "compatibility": {
    "source": {
      "format": "ssf",
      "version": "2.0"
    },
    "profile": "ssf/1",
    "mode": "preserve",
    "converter": "blinkfx-ssf-converter/1",
    "controls": {
      "rain": {
        "format": "ssf",
        "type": "toggle",
        "modifiers": []
      },
      "pop": {
        "format": "ssf",
        "type": "bang smooth",
        "modifiers": [
          "smooth"
        ],
        "params": 0.08
      },
      "feedback_on": {
        "format": "ssf",
        "type": "toggle smooth",
        "modifiers": [
          "smooth"
        ],
        "params": 0.08
      },
      "feedback_warp": {
        "format": "ssf",
        "type": "slider smooth",
        "modifiers": [
          "smooth"
        ],
        "params": 0.08
      },
      "speed_": {
        "format": "ssf",
        "type": "slider",
        "modifiers": []
      },
      "reverse": {
        "format": "ssf",
        "type": "toggle",
        "modifiers": []
      }
    },
    "scriptUniforms": {
      "script_time": "float",
      "bassTime_scr": "float"
    }
  },
