const float
  TAU           =2.*PI
, PI_2          =.5*PI







;

#define ROT(a)      mat2(cos(a), sin(a), -sin(a), cos(a))

vec4 spectrum(float x) {



  return textureLod(syn_Spectrum,vec2(x,0.5),0.);

