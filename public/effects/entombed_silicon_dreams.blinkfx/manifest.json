      "group": "Movement",
      "type": "float",
      "default": 4,
      "min": -9,
      "max": 9
    },
    {
      "name": "camera_direction",
      "label": "camera direction",
      "description": "Camera aim offset (X: left/right tilt, Y: up/down tilt)",
