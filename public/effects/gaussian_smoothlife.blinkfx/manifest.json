          "uniform": "syn_Media"
        }
      ],
      "target": {
        "name": "BuffC",
        "width": 1280,
        "height": 720,
        "format": "rgba32f",
        "sampling": {
          "filter": "linear",
          "wrap": "repeat"
        },
        "persistent": true
      },
