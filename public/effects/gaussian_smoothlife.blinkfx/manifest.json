{
  "format": "blinkfx/1",
  "id": "com.codexo.ssf.gaussian_smoothlife",
  "title": "Gaussian SmoothLife",
  "author": "cornusammonis",
  "description": "A variant of Stephan Rafler's SmoothLife that uses a separable Gaussian kernel to compute inner and outer fullness. The improvement in performance over full 2D convolution makes it possible to use a much larger kernel in realtime, without using FFT.",
  "thumbnail": "thumbnail.png",
  "tags": [
    "glitchy",
    "simulation",
    "groovy",
    "reaction-diffusion",
    "media"
  ],
  "kind": "generator",
  "controls": [
    {
      "name": "regime_toggle",
      "label": "regime toggle",
      "description": "OFF for quick splitting cells or ON for slow moving worms.",
      "group": "regime",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "cycling_rings",
      "label": "cycling rings",
      "description": "Concentric circles feed or poison the simulation.",
      "group": "regime",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "audio_reactivity",
      "label": "audio reactivity",
      "description": "Extra pulsing and shimmering with the music. Turn off to let it naturally progress.",
      "group": "regime",
      "type": "float",
      "default": 1,
      "min": 0,
      "max": 1
    },
    {
      "name": "no_blur",
      "label": "no blur",
      "description": "Removes the blur effect.",
      "group": "colorize",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "color_regime",
      "label": "color regime",
      "description": "Choose from one of 7 color palettes.",
      "group": "colorize",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 6.5
    },
    {
      "name": "greyscale",
      "label": "greyscale",
      "description": "Mix to greyscale for a more minimal look.",
      "group": "colorize",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1
    },
    {
      "name": "scale",
      "label": "scale",
      "description": "Lower for a lot of smaller cells. Higher for fewer, big cells.",
      "group": "parameters",
      "type": "float",
      "default": 1.3,
      "min": 0.2,
      "max": 2
    },
    {
      "name": "flow_resistance",
      "label": "flow resistance",
      "description": "Affects how fast it naturally travels.",
      "group": "parameters",
      "type": "float",
      "default": 1,
      "min": 0.8,
      "max": 3
    },
    {
      "name": "space_filling",
      "label": "space filling",
      "description": "Affects how eagerly it occupies empty space.",
      "group": "parameters",
      "type": "float",
      "default": 1,
      "min": 0.8,
      "max": 3
    },
    {
      "name": "contrast",
      "label": "contrast",
      "description": "Contrast of the feeding media.",
      "group": "media",
      "type": "float",
      "default": 1.5,
      "min": 0.5,
      "max": 4
    },
    {
      "name": "birth_lower",
      "label": "birth lower",
      "description": "Lower bound for the birth parameter.",
      "group": "advanced",
      "type": "float",
      "default": 1,
      "min": 0.8,
      "max": 2
    },
    {
      "name": "birth_upper",
      "label": "birth upper",
      "description": "Higher bound for the birth parameter (more important).",
      "group": "advanced",
      "type": "float",
      "default": 1,
      "min": 0.8,
      "max": 2
    },
    {
      "name": "survival_lower",
      "label": "survival lower",
      "description": "Lower bound for the survival parameter.",
      "group": "advanced",
      "type": "float",
      "default": 0.7,
      "min": 0.2,
      "max": 3
    },
    {
      "name": "survival_upper",
      "label": "survival upper",
      "description": "Higher bound for the survival parameter. (Turn this up if you're getting frequent black outs).",
      "group": "advanced",
      "type": "float",
      "default": 0.7,
      "min": 0.2,
      "max": 3
    },
    {
      "name": "timestep",
      "label": "timestep",
      "description": "Timestep. Turn this up for faster, glitchier action.",
      "group": "advanced",
      "type": "float",
      "default": 1,
      "min": 0.8,
      "max": 3
    },
    {
      "name": "xy_flow",
      "label": "xy flow",
      "description": "This applies a flow direction to the simulation. This interacts in complex ways with the other parameters. Try to search for different stable flow regimes.",
      "group": "advanced",
      "type": "point2d",
      "default": [
        0,
        0
      ],
      "min": [
        0,
        0
      ],
      "max": [
        1,
        1
      ]
    },
    {
      "name": "reset_sim",
      "label": "reset sim",
      "description": "If the simulation dies, return to default parameters and press this button.",
      "group": "utility",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1,
      "step": 1
    }
  ],
  "inputs": [
    {
      "name": "syn_Media",
      "type": "image",
      "required": false,
      "sampling": {
        "filter": "linear",
        "wrap": "repeat"
