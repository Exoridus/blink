      "inputs": [
        {
          "source": "target.BuffA",
          "uniform": "BuffA"
        },
        {
          "source": "target.BuffB",
          "uniform": "BuffB"
        },
        {
          "source": "target.BuffC.previous",
          "uniform": "BuffC"
        },
        {
          "source": "asset.image47",
