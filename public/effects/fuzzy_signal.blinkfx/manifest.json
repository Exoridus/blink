      "default": 1,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "glitch_flashes",
      "label": "glitch flashes",
      "description": "Audio-reactive glitch flashes",
      "group": "glitch",
      "type": "float",
      "default": 1,
      "min": 0,
      "max": 1
    },
    {
