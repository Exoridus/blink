{
  "format": "blinkfx/1",
  "id": "com.codexo.aurora",
  "title": "Aurora",
  "author": "Blink",
  "description": "Audio-reactive Aurora Borealis simulation with spectral colouring.",
  "license": "MIT",
  "tags": ["audio-reactive", "aurora", "spectrum"],
  "shaders": {
    "glsl": "shaders/main.frag.glsl"
  },
  "controls": [
    {
      "name": "speed",
      "label": "Speed",
      "type": "float",
      "default": 1.0,
      "min": 0.1,
      "max": 4.0,
      "step": 0.1,
      "group": "Motion"
    },
    {
      "name": "waves",
      "label": "Waves",
      "type": "int",
      "default": 5,
      "min": 1,
      "max": 12,
      "group": "Shape"
    },
    {
      "name": "spectral",
      "label": "Spectral",
      "type": "bool",
      "default": true,
      "group": "Color"
    },
    {
      "name": "baseColor",
      "label": "Base Color",
      "type": "color",
      "default": [0.0, 0.08, 0.15, 1.0],
      "group": "Color"
    }
  ]
}
