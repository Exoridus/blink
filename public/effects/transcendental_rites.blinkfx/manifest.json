{
  "format": "blinkfx/1",
  "id": "com.codexo.ssf.transcendental_rites",
  "title": "Transcendental Rites",
  "author": "Psybernautics - Alex Tiemann",
  "description": "We've come to worship.",
  "thumbnail": "thumbnail.png",
  "tags": [],
  "kind": "generator",
  "controls": [
    {
      "name": "media_color",
      "label": "media color",
      "description": "How much the media will appear.",
      "group": "color",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1
    },
    {
      "name": "rainbow",
      "label": "rainbow",
      "description": "Mix in rainbow color",
      "group": "color",
      "type": "float",
      "default": 0.45,
      "min": 0,
      "max": 1
    },
    {
      "name": "specular_strength",
      "label": "specular strength",
      "description": "How strong the specular light is.\nThe specular light color is the complement of the object's color.",
      "group": "color",
      "type": "float",
      "default": 100,
      "min": 1,
      "max": 100
    },
    {
      "name": "base_color",
      "label": "base color",
      "description": "base color, this color's complement will be calculated automatically",
      "group": "color",
      "type": "color",
      "default": [
        0.02109375,
        0.359375,
        0.9859375,
        1
      ]
    },
    {
      "name": "beat_stripe",
      "label": "beat stripe",
      "description": "ON: Apply black stripes to the scene color that move on drum beat.\nOFF: No stripes for you.",
      "group": "color",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "media_uv_or_3d",
      "label": "media uv or 3d",
      "description": "Toggle media coloring mode.\nOFF: Media is mapped to the uv coordinates of the screen. The geometry revels the media.\nON: Media is mapped to surface of the geomerty/",
      "group": "color",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "l_vert_mirr_mix",
      "label": "l vert mirr mix",
      "description": "Smoothly apply a left vertical mirror.",
      "group": "mirror",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "hor_mirr_mix",
      "label": "hor mirr mix",
      "description": "Smoothly apply a horizontal mirror.",
      "group": "mirror",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "audio_mir",
      "label": "audio mir",
      "description": "Smoothly ix between Left and Right vertical mirrors on beat detected.",
      "group": "mirror",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "feedback_on",
      "label": "feedback on",
      "description": "turn on feedback",
      "group": "feedback",
      "type": "float",
      "default": 0.97,
      "min": 0.3,
      "max": 0.97,
      "step": 0.6699999999999999
    },
    {
      "name": "bass_zoom",
      "label": "bass zoom",
      "description": "zoom on beat",
      "group": "feedback",
      "type": "float",
      "default": 1,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "zoom_direction",
      "label": "zoom direction",
      "description": "direction that the feedback zooms.",
      "group": "feedback",
      "type": "float",
      "default": 0.05,
      "min": -0.0999999995529652,
      "max": 0.0999999995529652
    },
    {
      "name": "fb_fade",
      "label": "fb fade",
      "description": "How much the feedback fades. Lower values retain feedback for longer.",
      "group": "feedback",
      "type": "float",
      "default": 0.05,
      "min": 0,
      "max": 0.2
    },
    {
      "name": "spire_count",
      "label": "spire count",
      "description": "Number of spires present.",
      "group": "geo",
      "type": "float",
      "default": 3,
      "min": 1,
      "max": 10
    },
    {
      "name": "rand_spire_count",
      "label": "rand spire count",
      "description": "Randomize the amount of spires on beat detected.",
      "group": "geo",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "geo_reactive_time",
      "label": "geo reactive time",
      "description": "ON: time variable is influenced by the audio bass. OFF: constant rate.",
      "group": "geo",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "geo_rate",
      "label": "geo rate",
      "description": "How fast the time variable for the geometry grows, whether it is reactive time or constant time.",
      "group": "geo",
      "type": "float",
      "default": 2,
      "min": -10,
      "max": 10
    },
    {
      "name": "FOV",
      "label": "FOV",
      "description": "Field of View for the perspective of the camera",
      "group": "camera",
      "type": "float",
      "default": 1.5,
      "min": 0.03125,
      "max": 3
    },
    {
      "name": "cam_morph",
      "label": "cam morph",
      "description": "Smoothly distort the camera.",
      "group": "camera",
      "type": "float",
      "default": 0.1,
      "min": 0,
      "max": 0.1,
      "step": 0.1
    },
    {
      "name": "in_da_tube",
      "label": "in da tube",
      "description": "Place the camera in the helix tube.",
      "group": "camera",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 39,
      "step": 39
    },
    {
      "name": "rand_mode",
      "label": "rand mode",
      "description": "Switch between in da tube and out da tube on beat detected.",
      "group": "camera",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "reactive_time",
      "label": "reactive time",
      "description": "ON: time variable is influenced by the audio bass. OFF: constant rate.",
      "group": "camera",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "spin_rate",
      "label": "spin rate",
      "description": "How fast the time variable grows, whether it is reactive time or constant time.",
      "group": "camera",
      "type": "float",
      "default": -3,
      "min": -10,
      "max": 10
    }
