float triGen(vec2 pos, float grower){
  pos.x *= (RENDERSIZE.x / RENDERSIZE.y);
  pos *= vec2(3.0,2.0)*2.0;
  pos += vec2(0.0,0.2+grower*8.0);
  pos.y += abs(pos.x);

  //        float r = triRand(sin(pos.y), grower);
