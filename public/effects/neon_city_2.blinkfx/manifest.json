{
  "format": "blinkfx/1",
  "id": "com.codexo.ssf.neon_city_2",
  "title": "Neon City by Night",
  "author": "mrange",
  "description": "Fly through an endless neon metropolis at night. Procedurally generated towers pulse with audio-reactive lighting, their glass facades reflecting cyan and magenta hues. The cityscape stretches infinitely ahead as you glide along a winding path through glowing streets. Features path-traced reflections, volumetric bloom, and glass refraction effects that interact beautifully with media layers.",
  "thumbnail": "thumbnail.png",
  "tags": [
    "mrange",
    "city",
    "neon",
    "night",
    "synthwave",
    "cyberpunk",
    "path tracing",
    "audio reactive",
    "buildings",
    "reflection",
    "glow",
    "motion blur",
    "urban",
    "fly through"
  ],
  "kind": "generator",
  "controls": [
    {
      "name": "density",
      "label": "density",
      "description": "Tower density – more neon buildings fill the cityscape",
      "group": "City",
      "type": "float",
      "default": 0.8,
      "min": 0,
      "max": 1
    },
    {
      "name": "height_mul",
      "label": "height mul",
      "description": "Audio reactivity – building heights respond to spectrum",
      "group": "City",
      "type": "float",
      "default": 1,
      "min": 0,
      "max": 2
    },
    {
      "name": "lighting_mode",
      "label": "lighting mode",
      "description": "Switch between per-frequency FFT and transient hit reactivity",
      "group": "City",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 2,
      "step": 1
    },
    {
      "name": "neon_hue",
      "label": "neon hue",
      "description": "Neon hue – rotate the color palette of neon lights",
      "group": "City",
      "type": "float",
      "default": 5,
      "min": 0,
      "max": 7
    },
    {
      "name": "reflection",
      "label": "reflection",
      "description": "Glass reflectivity – toggle Fresnel reflections on building facades",
      "group": "City",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "tower_lights",
      "label": "tower lights",
      "description": "Tower top lights – toggle the glowing cores and halos at building tops and edges",
      "group": "City",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "height",
      "label": "height",
      "description": "Camera height – elevation above city streets",
      "group": "Movement",
      "type": "float",
      "default": 2.1,
      "min": 2.1,
      "max": 2.9
    },
    {
      "name": "speed",
      "label": "speed",
      "description": "Travel speed – camera movement through the city",
      "group": "Movement",
      "type": "float",
      "default": 0.5,
      "min": -5,
      "max": 5
    },
    {
      "name": "path_amplitude",
      "label": "path amplitude",
      "description": "Camera path amplitude – how far the camera weaves side to side",
      "group": "Movement",
      "type": "float",
      "default": 1,
      "min": 0,
      "max": 2
    },
    {
      "name": "path_frequency",
      "label": "path frequency",
      "description": "Camera path frequency – how fast the camera weaves",
      "group": "Movement",
      "type": "float",
      "default": 0.33,
      "min": 0,
      "max": 0.5
    },
    {
      "name": "camera_mode",
      "label": "camera mode",
      "description": "pick between various camera views",
      "group": "Movement",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 2,
      "step": 1
    },
    {
      "name": "motion_blur",
      "label": "motion blur",
      "description": "Motion blur – smooth camera movement trails",
      "group": "Fx",
      "type": "float",
      "default": 0.5,
      "min": 0,
      "max": 0.99
    },
    {
      "name": "retain_glow",
      "label": "retain glow",
      "description": "Glow persistence – retain bloom across frames",
      "group": "Fx",
      "type": "float",
      "default": 0.8,
      "min": 0,
      "max": 0.99
    },
    {
      "name": "neon_glow",
      "label": "neon glow",
      "description": "Glow intensity – brighten neon light bloom",
      "group": "Fx",
      "type": "float",
      "default": 0.5,
      "min": 0,
      "max": 1
    },
    {
      "name": "media_transparency",
      "label": "media transparency",
      "description": "Media opacity – fade visuals in or out",
      "group": "Media",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1
    },
    {
      "name": "glass_effect",
      "label": "glass effect",
      "description": "Glass effect – 0 for no glass, 1 for full refraction and bloom overlay on media",
      "group": "Media",
      "type": "float",
      "default": 0.5,
      "min": 0,
      "max": 1
    },
    {
      "name": "media_multiplier",
      "label": "media multiplier",
      "description": "Media multiplier – boost opacity for bold color effects",
      "group": "Media",
      "type": "float",
      "default": 1,
      "min": -5,
      "max": 5
    },
    {
      "name": "billboard_density",
      "label": "billboard density",
      "description": "Billboard density – how many buildings display a media billboard (requires media input)",
      "group": "Media",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1
    },
    {
      "name": "trigger_wave",
      "label": "trigger wave",
      "description": "Trigger a height wave through the city",
      "group": "Wave",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "wave_speed",
      "label": "wave speed",
      "description": "How fast the wave travels through buildings",
      "group": "Wave",
      "type": "float",
      "default": 5,
      "min": 5,
      "max": 20
    }
  ],
  "inputs": [
    {
      "name": "syn_Media",
      "type": "image",
      "required": false,
      "sampling": {
        "filter": "linear",
        "wrap": "mirror"
      }
    }
  ],
  "passes": [
    {
      "name": "pass0",
      "shader": "main",
      "inputs": [
        {
          "source": "target.pass0.previous",
          "uniform": "pass0"
        },
        {
          "source": "target.pass1.previous",
          "uniform": "pass1"
        },
        {
          "source": "target.pass2.previous",
          "uniform": "pass2"
        },
        {
          "source": "blink.audio.spectrum",
          "uniform": "syn_Spectrum"
        },
        {
          "source": "input.syn_Media",
          "uniform": "syn_Media"
        }
      ],
      "target": {
        "name": "pass0",
        "width": 1920,
        "height": 1080,
        "format": "rgba32f",
        "sampling": {
          "filter": "nearest",
          "wrap": "clamp"
        },
        "persistent": true
      },
      "clear": false
    },
    {
      "name": "pass1",
      "shader": "main",
      "inputs": [
        {
          "source": "target.pass0",
          "uniform": "pass0"
        },
        {
          "source": "target.pass1.previous",
          "uniform": "pass1"
        },
        {
          "source": "target.pass2.previous",
          "uniform": "pass2"
        },
        {
          "source": "blink.audio.spectrum",
          "uniform": "syn_Spectrum"
        },
        {
          "source": "input.syn_Media",
          "uniform": "syn_Media"
        }
      ],
      "target": {
        "name": "pass1",
        "width": 1920,
        "height": 1080,
        "format": "rgba32f",
        "sampling": {
          "filter": "nearest",
          "wrap": "clamp"
        },
        "persistent": true
      },
      "clear": false
    },
    {
      "name": "pass2",
      "shader": "main",
      "inputs": [
        {
          "source": "target.pass0",
          "uniform": "pass0"
        },
        {
          "source": "target.pass1",
          "uniform": "pass1"
        },
        {
          "source": "target.pass2.previous",
          "uniform": "pass2"
        },
        {
          "source": "blink.audio.spectrum",
          "uniform": "syn_Spectrum"
        },
        {
          "source": "input.syn_Media",
          "uniform": "syn_Media"
        }
      ],
      "target": {
        "name": "pass2",
        "width": 1920,
        "height": 1080,
        "format": "rgba32f",
        "sampling": {
          "filter": "nearest",
          "wrap": "clamp"
        },
        "persistent": true
      },
      "clear": false
    },
    {
      "name": "final",
      "shader": "main",
      "inputs": [
        {
          "source": "target.pass0",
          "uniform": "pass0"
        },
        {
          "source": "target.pass1",
          "uniform": "pass1"
        },
        {
          "source": "target.pass2",
          "uniform": "pass2"
        },
        {
          "source": "blink.audio.spectrum",
          "uniform": "syn_Spectrum"
        },
        {
          "source": "input.syn_Media",
          "uniform": "syn_Media"
        }
      ],
      "target": "screen",
      "clear": true
    }
  ],
  "shaders": {
    "glsl": {
      "main": "shaders/main.frag.glsl"
    }
  },
  "script": {
    "entry": "script.js",
    "abi": "ssf/1"
  },
