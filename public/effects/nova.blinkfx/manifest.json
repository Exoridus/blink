  "kind": "generator",
  "controls": [
    {
      "name": "simplify",
      "label": "simplify",
      "description": "Turn up to simplify the scene into a few splotches of color.",
      "group": "zoom",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1
    },
    {
      "name": "sandstorm",
      "label": "sandstorm",
      "description": "'Zooms Out' when turned up, causing a grainy effect like a sandstorm.",
      "group": "zoom",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1
    },
    {
      "name": "flashing",
      "label": "flashing",
      "description": "Cause the slopes of the texture to highlight on high percussive hits.",
      "group": "action",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "pulsate",
      "label": "pulsate",
      "description": "While ON, pulses emanate outwards synced to the BPM of the song.",
      "group": "action",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "radial_grid",
      "label": "radial grid",
      "description": "A radial grid effect that emanates out from the center like rays of energy.",
      "group": "action",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "beat_rotate",
      "label": "beat rotate",
