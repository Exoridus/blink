{
  "format": "blinkfx/1",
  "id": "com.codexo.ssf.neon_city",
  "title": "Neon City by Night",
  "author": "mrange",
  "description": "Fly through an endless neon metropolis at night. Procedurally generated towers pulse with audio-reactive lighting, their glass facades reflecting cyan and magenta hues. The cityscape stretches infinitely ahead as you glide along a winding path through glowing streets. Features path-traced reflections, volumetric bloom, and glass refraction effects that interact beautifully with media layers.",
  "thumbnail": "thumbnail.png",
  "tags": [
    "mrange",
    "city",
    "neon",
    "night",
    "synthwave",
    "cyberpunk",
    "path tracing",
    "audio reactive",
    "buildings",
    "reflection",
    "glow",
    "motion blur",
    "urban",
    "fly through"
  ],
  "kind": "generator",
  "controls": [
    {
      "name": "tower_threshold",
      "label": "tower threshold",
      "description": "Tower threshold – higher values reveal more neon buildings",
      "group": "Visual",
      "type": "float",
      "default": 0.2,
      "min": 0,
      "max": 1
    },
    {
      "name": "motion_blur",
      "label": "motion blur",
      "description": "Motion blur – smooth camera movement trails",
      "group": "Visual",
      "type": "float",
      "default": 0.5,
      "min": 0,
      "max": 1
    },
    {
      "name": "audio_reactivity",
      "label": "audio reactivity",
      "description": "Audio reactivity – building heights respond to spectrum",
      "group": "Visual",
      "type": "float",
      "default": 1,
      "min": 0,
      "max": 1
    },
    {
      "name": "reflection",
      "label": "reflection",
      "description": "Surface reflection – Fresnel min/max for building glass",
      "group": "Visual",
      "type": "point2d",
      "default": [
        0.0625,
        0.75
      ],
      "min": [
        0,
        0
      ],
      "max": [
        1,
        1
      ]
    },
    {
      "name": "audio_threshold",
      "label": "audio threshold",
      "description": "Audio threshold – filter out quiet audio values",
      "group": "Visual",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 0.9
    },
    {
      "name": "neon_color",
      "label": "neon color",
      "description": "Neon hue – color phase shifts for cyan/magenta tones",
      "group": "Visual",
      "type": "point2d",
      "default": [
        5,
        2
      ],
      "min": [
        0,
        0
      ],
      "max": [
        7,
        7
      ]
    },
    {
      "name": "retain_glow",
      "label": "retain glow",
      "description": "Glow persistence – retain bloom across frames",
      "group": "Visual",
      "type": "float",
      "default": 0.8,
      "min": 0,
      "max": 1
    },
    {
      "name": "neon_glow",
      "label": "neon glow",
      "description": "Glow intensity – brighten neon light bloom",
      "group": "Visual",
      "type": "float",
      "default": 0.5,
      "min": 0,
      "max": 1
    },
    {
      "name": "glass_blend",
      "label": "glass blend",
      "description": "Glass blend – media layer viewed through glow tint",
      "group": "Visual",
      "type": "float",
      "default": 0.5,
      "min": 0,
      "max": 1
    },
    {
      "name": "media_opacity",
      "label": "media opacity",
      "description": "Media opacity – fade visuals in or out",
      "group": "Media",
      "type": "float",
      "default": 1,
      "min": 0,
      "max": 1
    },
    {
      "name": "media_intensity",
      "label": "media intensity",
      "description": "Media intensity – amplify blend (negative inverts)",
      "group": "Media",
      "type": "float",
      "default": 1,
      "min": -5,
      "max": 5
    },
    {
      "name": "media_mask",
      "label": "media mask",
      "description": "Media mask – luminance threshold for glass blend",
      "group": "Media",
      "type": "point2d",
      "default": [
        0.25,
        0.5
      ],
      "min": [
        0,
        0
      ],
      "max": [
        1,
        1
      ]
    },
    {
      "name": "speed",
      "label": "speed",
      "description": "Travel speed – camera movement through the city",
      "group": "Movement",
      "type": "float",
      "default": 0.5,
      "min": -5,
      "max": 5
    },
    {
      "name": "path_wave",
      "label": "path wave",
      "description": "Camera path – sine wave amplitude and frequency",
      "group": "Movement",
      "type": "point2d",
      "default": [
        1,
        0.33
      ],
      "min": [
        0,
        0
      ],
      "max": [
        2,
        0.5
      ]
    },
    {
      "name": "camera_height",
      "label": "camera height",
      "description": "Camera height – elevation above city streets",
      "group": "Movement",
      "type": "float",
      "default": 2.1,
      "min": 2.1,
      "max": 2.9
    }
  ],
  "inputs": [
    {
      "name": "syn_Media",
      "type": "image",
      "required": false,
      "sampling": {
        "filter": "linear",
        "wrap": "mirror"
      }
    }
  ],
  "passes": [
    {
      "name": "pass0",
      "shader": "main",
      "inputs": [
