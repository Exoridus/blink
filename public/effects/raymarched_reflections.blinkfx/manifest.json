        ],
        "params": 0.005
      },
      "FOV": {
        "format": "ssf",
        "type": "knob smooth",
        "modifiers": [
          "smooth"
        ],
        "params": 0.035
      },
      "fisheye": {
        "format": "ssf",
        "type": "knob smooth",
        "modifiers": [
          "smooth"
        ],
        "params": 0.05
      },
      "anti_aliasing_fps": {
        "format": "ssf",
        "type": "toggle",
        "modifiers": []
      }
    },
    "scriptUniforms": {
      "moveRightScr": "float",
