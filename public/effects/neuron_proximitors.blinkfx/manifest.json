      },
      "flashing_lines": {
        "format": "ssf",
        "type": "toggle",
        "modifiers": []
      },
      "minimal_mode": {
        "format": "ssf",
        "type": "toggle",
        "modifiers": []
      },
      "FPS_fewer_particles": {
        "format": "ssf",
