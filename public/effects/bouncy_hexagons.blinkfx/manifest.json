  "inputs": [
    {
      "name": "syn_Media",
      "type": "image",
      "required": false,
      "sampling": {
        "filter": "linear",
        "wrap": "mirror"
      }
    },
    {
      "name": "syn_UserImage",
      "type": "image",
      "required": false,
      "sampling": {
        "filter": "linear",
        "wrap": "mirror"
      }
    }
  ],
  "assets": [
    {
      "name": "t_fbm",
      "type": "texture2d",
      "path": "assets/fbm.png",
      "sampling": {
        "filter": "mipmap",
        "wrap": "repeat"
      }
    }
  ],
  "passes": [
    {
      "name": "pass0",
      "shader": "main",
      "inputs": [
        {
          "source": "target.pass0.previous",
          "uniform": "pass0"
        },
        {
          "source": "asset.t_fbm",
          "uniform": "t_fbm"
        },
        {
          "source": "blink.audio.spectrum",
          "uniform": "syn_Spectrum"
        },
        {
          "source": "input.syn_Media",
          "uniform": "syn_Media"
        },
        {
          "source": "input.syn_UserImage",
          "uniform": "syn_UserImage"
        },
        {
          "source": "target.syn_FinalBuffer.previous",
          "uniform": "syn_FinalPass"
        }
      ],
      "target": {
        "name": "pass0",
        "width": 1920,
        "height": 1080,
        "format": "rgba32f",
        "sampling": {
          "filter": "linear",
          "wrap": "repeat"
        },
        "persistent": true
      },
      "clear": false
    },
    {
      "name": "main",
      "shader": "main",
      "inputs": [
        {
          "source": "target.pass0",
          "uniform": "pass0"
        },
        {
          "source": "asset.t_fbm",
          "uniform": "t_fbm"
        },
        {
          "source": "blink.audio.spectrum",
          "uniform": "syn_Spectrum"
        },
        {
          "source": "input.syn_Media",
          "uniform": "syn_Media"
        },
        {
          "source": "input.syn_UserImage",
          "uniform": "syn_UserImage"
        },
        {
          "source": "target.syn_FinalBuffer.previous",
          "uniform": "syn_FinalPass"
        }
      ],
      "target": {
        "name": "syn_FinalBuffer",
        "format": "rgba8",
        "persistent": true
      },
      "clear": true
    },
    {
      "name": "present",
      "shader": "present",
      "inputs": [
        {
          "source": "target.syn_FinalBuffer",
          "uniform": "present_source"
        }
      ],
      "target": "screen",
      "clear": true
    }
  ],
  "shaders": {
    "glsl": {
      "main": "shaders/main.frag.glsl",
      "present": "shaders/present.frag.glsl"
    }
  },
