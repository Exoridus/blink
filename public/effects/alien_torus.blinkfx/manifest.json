      "target": {
        "name": "vertMirrPass",
        "width": 1920,
        "height": 1080,
        "format": "rgba32f",
        "sampling": {
          "filter": "linear",
          "wrap": "repeat"
        },
        "persistent": true
      },
      "clear": false
    },
    {
      "name": "final",
      "shader": "main",
      "inputs": [
        {
          "source": "target.mainPass",
          "uniform": "mainPass"
        },
        {
          "source": "target.edgePass",
          "uniform": "edgePass"
        },
        {
          "source": "target.horMirrPass",
          "uniform": "horMirrPass"
        },
        {
          "source": "target.vertMirrPass",
          "uniform": "vertMirrPass"
        },
        {
          "source": "input.syn_UserImage",
          "uniform": "syn_UserImage"
        }
      ],
      "target": "screen",
      "clear": true
    }
  ],
