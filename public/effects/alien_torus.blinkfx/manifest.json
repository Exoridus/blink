      "group": "mirror",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1
    },
    {
      "name": "geo_reactive_time",
      "label": "geo reactive time",
      "description": "ON: time variable is influenced by the audio bass. OFF: constant rate.",
      "group": "geometry",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "geo_rate",
      "label": "geo rate",
      "description": "How fast the time variable grows, whether it is reactive time or constant time.",
      "group": "geometry",
      "type": "float",
      "default": 2,
      "min": -5,
      "max": 5
    },
    {
      "name": "satellites",
      "label": "satellites",
      "description": "Number of satellite geometries encircling the torus cemter",
      "group": "geometry",
      "type": "float",
      "default": 4,
      "min": 0,
      "max": 24
    },
    {
      "name": "sat_scale",
      "label": "sat scale",
      "description": "Scale the size of the satellites",
      "group": "geometry",
      "type": "float",
      "default": 1,
      "min": 0.5,
      "max": 1.5
    },
    {
      "name": "gooey",
      "label": "gooey",
      "description": "How strong the satellites are unioned with the torus",
      "group": "geometry",
      "type": "float",
      "default": 0.25,
      "min": 0.1,
      "max": 1
    },
    {
      "name": "orbit_width",
      "label": "orbit width",
      "description": "Increase/Descrease the diameter of the satellites' orbit path.",
      "group": "geometry",
      "type": "float",
      "default": 0,
      "min": -0.5,
      "max": 1
    },
    {
      "name": "random_geo",
      "label": "random geo",
      "description": "ON: choose random combination of cage and ring geometry geometry on beat.",
      "group": "geometry",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "ring_or_cage",
      "label": "ring or cage",
      "description": "Smoothly blend between ring and cage geometries",
      "group": "geometry",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1
    },
    {
      "name": "audio_twist",
      "label": "audio twist",
      "description": "Twist the torus according the geo time variable",
      "group": "geometry",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "twist_val",
      "label": "twist val",
      "description": "How much the torus is twisted",
      "group": "geometry",
      "type": "float",
      "default": 0.355,
      "min": -0.5,
      "max": 0.5
    },
    {
      "name": "displace_surface",
      "label": "displace surface",
      "description": "Displaces the surface of the torus",
      "group": "geometry",
      "type": "float",
      "default": 3,
      "min": 1,
      "max": 10
    }
