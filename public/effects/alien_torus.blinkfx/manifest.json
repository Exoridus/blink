        {
          "source": "target.edgePass",
          "uniform": "edgePass"
        },
        {
          "source": "target.horMirrPass.previous",
          "uniform": "horMirrPass"
        },
        {
          "source": "target.vertMirrPass.previous",
          "uniform": "vertMirrPass"
        },
        {
          "source": "input.syn_UserImage",
          "uniform": "syn_UserImage"
        }
      ],
      "target": {
        "name": "horMirrPass",
        "width": 1920,
        "height": 1080,
        "format": "rgba32f",
        "sampling": {
          "filter": "linear",
          "wrap": "repeat"
        },
        "persistent": true
      },
      "clear": false
    },
    {
      "name": "vertMirrPass",
      "shader": "main",
      "inputs": [
        {
          "source": "target.mainPass",
          "uniform": "mainPass"
        },
        {
          "source": "target.edgePass",
          "uniform": "edgePass"
        },
        {
          "source": "target.horMirrPass",
          "uniform": "horMirrPass"
        },
        {
          "source": "target.vertMirrPass.previous",
          "uniform": "vertMirrPass"
