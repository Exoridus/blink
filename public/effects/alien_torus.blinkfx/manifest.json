{
  "format": "blinkfx/1",
  "id": "com.codexo.ssf.alien_torus",
  "title": "Alien Torus",
  "author": "Psybernautics - Alex Tiemann",
  "description": "Inverted Torus encircled by geometric satellites.",
  "thumbnail": "thumbnail.png",
  "tags": [],
  "kind": "generator",
  "controls": [
    {
      "name": "diffuse_strength",
      "label": "diffuse strength",
      "description": "Diffused light strength",
      "group": "color",
      "type": "float",
      "default": 1,
      "min": 0.05,
      "max": 1
    },
    {
      "name": "brightness",
      "label": "brightness",
      "description": "How bright the scene is.",
      "group": "color",
      "type": "float",
      "default": 100,
      "min": 100,
      "max": 100
    },
    {
      "name": "base_color",
      "label": "base color",
      "description": "base color, this color's complement will be calculated automatically",
      "group": "color",
      "type": "color",
      "default": [
        0.12109375,
        0.359375,
        0.5859375,
        1
      ]
    },
    {
      "name": "audio_edge",
      "label": "audio edge",
      "description": "edge detection on bass hits.",
      "group": "color",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "rainbow",
      "label": "rainbow",
      "description": "Mix in rainbow color",
      "group": "color",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1
    },
    {
      "name": "rainbow_width",
      "label": "rainbow width",
      "description": "How wide the stripes in the rainbow are",
      "group": "color",
      "type": "float",
      "default": 1,
      "min": 1,
      "max": 1
    },
    {
      "name": "edge_mix",
      "label": "edge mix",
      "description": "How much edge detection is present in the shader.",
      "group": "color",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1
    },
    {
      "name": "reflectivity",
      "label": "reflectivity",
      "description": "How reflective the geometry is",
      "group": "color",
      "type": "float",
      "default": 1,
      "min": 0.2,
      "max": 1
    },
    {
      "name": "lookXY",
      "label": "lookXY",
      "description": "Move the camera",
      "group": "camera",
      "type": "point2d",
      "default": [
        0.125,
        0.125
      ],
      "min": [
        0.125,
        0.125
      ],
      "max": [
        0.125,
        0.125
      ]
    },
    {
      "name": "reactive_time",
      "label": "reactive time",
      "description": "ON: time variable is influenced by the audio bass. OFF: constant rate.",
      "group": "camera",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "rate_in",
      "label": "rate in",
      "description": "How fast the time variable grows, whether it is reactive time or constant time.",
      "group": "camera",
      "type": "float",
      "default": 2.5,
      "min": -10,
      "max": 10
    },
    {
      "name": "f_o_v",
      "label": "f o v",
      "description": "field of view from the perspective of the camera",
      "group": "camera",
      "type": "float",
      "default": 1,
      "min": 0.15,
      "max": 2
    },
    {
      "name": "media_color",
      "label": "media color",
      "description": "How much the media will appear directly painted on the objects",
      "group": "media",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1
    },
    {
      "name": "media_scale",
      "label": "media scale",
      "description": "Control the scale of the media",
      "group": "media",
      "type": "float",
      "default": 1,
      "min": 1,
      "max": 1
    },
    {
      "name": "multiply_media",
      "label": "multiply media",
      "description": "Multiply the scene color with the media color",
      "group": "media",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "bass_mult",
      "label": "bass mult",
      "description": "Multiply the scene color with the media color according the bass presences in the audio",
      "group": "media",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "hor_mir_mix",
      "label": "hor mir mix",
      "description": "Smooth Horizontal Mirror Mix",
      "group": "mirror",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1
    },
    {
      "name": "vert_mir_mix",
      "label": "vert mir mix",
