      "inputs": [
        {
          "source": "target.mainPass",
          "uniform": "mainPass"
        },
        {
          "source": "target.secondPass",
          "uniform": "secondPass"
        },
        {
          "source": "target.rVertMirrPass.previous",
          "uniform": "rVertMirrPass"
        },
        {
          "source": "input.syn_UserImage",
          "uniform": "syn_UserImage"
        }
      ],
      "target": {
        "name": "rVertMirrPass",
        "width": 1920,
        "height": 1080,
        "format": "rgba32f",
        "sampling": {
          "filter": "linear",
          "wrap": "repeat"
        },
        "persistent": true
      },
      "clear": false
    },
    {
      "name": "final",
      "shader": "main",
      "inputs": [
        {
          "source": "target.mainPass",
          "uniform": "mainPass"
        },
        {
          "source": "target.secondPass",
          "uniform": "secondPass"
        },
        {
          "source": "target.rVertMirrPass",
          "uniform": "rVertMirrPass"
        },
        {
          "source": "input.syn_UserImage",
          "uniform": "syn_UserImage"
        }
      ],
      "target": "screen",
      "clear": true
    }
