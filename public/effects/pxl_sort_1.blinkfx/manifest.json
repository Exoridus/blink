        "modifiers": [
          "smooth"
        ],
        "params": 0.25
      },
      "colorize": {
        "format": "ssf",
        "type": "bang",
        "modifiers": []
      },
      "reverse": {
        "format": "ssf",
        "type": "toggle",
        "modifiers": []
      },
      "blend": {
        "format": "ssf",
        "type": "toggle",
        "modifiers": []
      },
      "speed": {
        "format": "ssf",
        "type": "slider",
        "modifiers": []
      }
    }
  },
