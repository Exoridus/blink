{
  "format": "blinkfx/1",
  "id": "com.codexo.ssf.pxl_sort_1",
  "title": "pxl_sort_1",
  "author": "Meebs",
  "thumbnail": "thumbnail.png",
  "tags": [
    "feedback",
    "media",
    "morphing",
    "displacement"
  ],
  "kind": "generator",
  "controls": [
    {
      "name": "PICK_MEDIA",
      "label": "PICK MEDIA",
      "description": "This scene only works if you have selected 'Media' below!",
      "group": "media",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "auto_refresh",
      "label": "auto refresh",
      "description": "Automatically refresh based on the music, rather than manually control.",
      "group": "refresh",
      "type": "float",
      "default": 1,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "refresh",
      "label": "refresh",
      "description": "Reset the pixel sort with a new frame from the media",
      "group": "refresh",
      "type": "float",
      "default": 1,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "scale_liquid",
      "label": "scale liquid",
      "group": "liquid",
      "type": "float",
      "default": 3.1,
      "min": 0,
      "max": 5
    },
    {
      "name": "auto_liquid",
      "label": "auto liquid",
      "description": "Automatically liquify based on the music, rather than manually control with the bang below.",
      "group": "liquid",
      "type": "float",
      "default": 1,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "liquify",
      "label": "liquify",
      "group": "liquid",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "invert",
      "label": "invert",
      "description": "Reset simulation to underlying media.",
      "group": "color",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "colorize",
      "label": "colorize",
      "group": "color",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "reverse",
      "label": "reverse",
      "group": "sort",
      "type": "float",
      "default": 1,
      "min": -1,
      "max": 1,
      "step": 2
    },
    {
      "name": "blend",
      "label": "blend",
      "group": "sort",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "speed",
      "label": "speed",
      "group": "sort",
      "type": "float",
      "default": 2,
      "min": 0,
      "max": 8
    }
  ],
  "inputs": [
    {
      "name": "syn_Media",
      "type": "image",
      "required": false,
      "sampling": {
        "filter": "linear",
        "wrap": "repeat"
      }
    }
  ],
  "passes": [
    {
      "name": "backbuffer",
      "shader": "main",
      "inputs": [
        {
          "source": "target.backbuffer.previous",
          "uniform": "backbuffer"
        },
        {
          "source": "input.syn_Media",
          "uniform": "syn_Media"
        }
      ],
      "target": {
        "name": "backbuffer",
        "format": "rgba32f",
        "sampling": {
          "filter": "linear",
          "wrap": "repeat"
        },
        "persistent": true
      },
      "clear": false
    },
    {
      "name": "final",
      "shader": "main",
      "inputs": [
        {
          "source": "target.backbuffer",
          "uniform": "backbuffer"
        },
        {
          "source": "input.syn_Media",
          "uniform": "syn_Media"
        }
      ],
      "target": "screen",
      "clear": true
    }
  ],
  "shaders": {
    "glsl": {
      "main": "shaders/main.frag.glsl"
    }
  },
  "compatibility": {
    "source": {
      "format": "ssf",
      "version": "2.0"
    },
    "profile": "ssf/1",
    "mode": "preserve",
    "converter": "blinkfx-ssf-converter/1",
    "controls": {
      "PICK_MEDIA": {
        "format": "ssf",
        "type": "toggle",
        "modifiers": []
      },
      "auto_refresh": {
        "format": "ssf",
