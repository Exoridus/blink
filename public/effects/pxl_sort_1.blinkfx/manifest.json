        "modifiers": []
      },
      "refresh": {
        "format": "ssf",
        "type": "bang smooth",
        "modifiers": [
          "smooth"
        ],
        "params": 0.25
      },
      "scale_liquid": {
        "format": "ssf",
        "type": "slider",
        "modifiers": []
      },
      "auto_liquid": {
        "format": "ssf",
        "type": "toggle",
        "modifiers": []
      },
      "liquify": {
        "format": "ssf",
        "type": "bang smooth",
        "modifiers": [
          "smooth"
        ],
        "params": 0.55
      },
      "invert": {
