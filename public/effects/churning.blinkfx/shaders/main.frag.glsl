  hZone = (1.0 - abs(mod(syn_BassTime*0.05, (2.0)) - 1.0))-0.5;
  tiltShiftZone = (1.0-smoothstep(0.0+hZone, 0.5+hZone, _uv.y))+(smoothstep(0.5+hZone, 1.0+hZone, _uv.y));
  fragColor = renderMain();
}
