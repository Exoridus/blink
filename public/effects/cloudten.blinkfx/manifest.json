{
  "format": "blinkfx/1",
  "id": "com.codexo.ssf.cloudten",
  "title": "Cloud Ten",
  "author": "nimitz",
  "thumbnail": "thumbnail.png",
  "tags": [
    "3d",
    "raymarching",
    "realistic"
  ],
  "kind": "generator",
  "controls": [
    {
      "name": "auto_height",
      "label": "auto height",
      "description": "Automatically rise above and fall below the cloud layer based on the rise and fall of action in the music.",
      "group": "height",
      "type": "float",
      "default": 1,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "manual_height",
      "label": "manual height",
      "description": "auto height MUST BE SET TO OFF. Manually control the height of the camera in the scene.",
      "group": "height",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1
    },
    {
      "name": "flip_side",
      "label": "flip side",
      "description": "Flip entire scene over, turning it from a city to a starry sky, and from a flying over clouds to under water.",
      "group": "motion",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "horizontal_motion",
      "label": "horizontal motion",
      "description": "Strafe camera back and forth by turning knob.",
      "group": "motion",
      "type": "float",
      "default": 0.5,
      "min": 0,
      "max": 1
    },
    {
      "name": "sun_position",
      "label": "sun position",
      "description": "Change sun height in sky, resulting in deeper red sunset or white light from a high sun position.",
      "group": "motion",
      "type": "float",
      "default": 0.5,
      "min": 0,
      "max": 1
    },
    {
      "name": "speed",
      "label": "speed",
      "description": "Change how fast you fly through the clouds. Higher is faster, lower is slower.",
      "group": "motion",
      "type": "float",
      "default": 0.3,
      "min": 0,
      "max": 1.5
    },
    {
      "name": "city_fps",
      "label": "city fps",
      "description": "Turn OFF to stop the generation of the city/stars and preserve FPS.",
      "group": "fps",
      "type": "float",
      "default": 1,
      "min": 0,
      "max": 1,
      "step": 1
    }
  ],
  "inputs": [
    {
      "name": "syn_UserImage",
      "type": "image",
      "required": false,
      "sampling": {
        "filter": "linear",
        "wrap": "repeat"
      }
    }
  ],
  "assets": [
    {
      "name": "colornoise",
      "type": "texture2d",
      "path": "assets/colornoise.jpg",
      "sampling": {
        "filter": "mipmap",
        "wrap": "repeat"
      }
    }
  ],
  "passes": [
    {
      "name": "buffer1",
      "shader": "main",
      "inputs": [
        {
          "source": "target.buffer1.previous",
          "uniform": "buffer1"
        },
        {
          "source": "target.cityClouds.previous",
          "uniform": "cityClouds"
        },
        {
          "source": "asset.colornoise",
          "uniform": "colornoise"
        },
        {
          "source": "input.syn_UserImage",
          "uniform": "syn_UserImage"
        }
      ],
      "target": {
        "name": "buffer1",
        "width": 640,
        "height": 360,
        "format": "rgba32f",
        "sampling": {
          "filter": "linear",
          "wrap": "repeat"
        },
        "persistent": true
      },
      "clear": false
    },
    {
      "name": "cityClouds",
      "shader": "main",
      "inputs": [
        {
          "source": "target.buffer1",
          "uniform": "buffer1"
        },
        {
          "source": "target.cityClouds.previous",
          "uniform": "cityClouds"
        },
        {
          "source": "asset.colornoise",
          "uniform": "colornoise"
        },
        {
          "source": "input.syn_UserImage",
          "uniform": "syn_UserImage"
        }
      ],
      "target": {
        "name": "cityClouds",
        "width": 1920,
        "height": 1280,
        "format": "rgba32f",
        "sampling": {
          "filter": "linear",
          "wrap": "repeat"
        },
        "persistent": true
      },
      "clear": false
    },
    {
      "name": "final",
      "shader": "main",
      "inputs": [
        {
          "source": "target.buffer1",
          "uniform": "buffer1"
        },
        {
          "source": "target.cityClouds",
          "uniform": "cityClouds"
        },
        {
          "source": "asset.colornoise",
          "uniform": "colornoise"
        },
        {
          "source": "input.syn_UserImage",
          "uniform": "syn_UserImage"
        }
      ],
      "target": "screen",
      "clear": true
    }
  ],
  "shaders": {
    "glsl": {
      "main": "shaders/main.frag.glsl"
    }
  },
  "script": {
    "entry": "script.js",
    "abi": "ssf/1"
  },
  "requirements": {
    "features": [
      "script:ssf/1"
    ]
  },
  "compatibility": {
    "source": {
      "format": "ssf",
      "version": "2.0"
    },
    "profile": "ssf/1",
    "mode": "preserve",
    "converter": "blinkfx-ssf-converter/1",
    "controls": {
      "auto_height": {
        "format": "ssf",
        "type": "toggle",
        "modifiers": []
      },
      "manual_height": {
        "format": "ssf",
        "type": "slider smooth",
        "modifiers": [
          "smooth"
        ],
        "params": 0.05
      },
      "flip_side": {
        "format": "ssf",
        "type": "toggle",
        "modifiers": []
      },
      "horizontal_motion": {
        "format": "ssf",
        "type": "knob smooth",
        "modifiers": [
          "smooth"
        ],
        "params": 0.05
      },
      "sun_position": {
        "format": "ssf",
        "type": "slider smooth",
        "modifiers": [
          "smooth"
        ],
        "params": 0.05
      },
      "speed": {
        "format": "ssf",
        "type": "slider smooth",
        "modifiers": [
          "smooth"
        ],
        "params": 0.05
      },
      "city_fps": {
        "format": "ssf",
        "type": "toggle smooth",
        "modifiers": [
          "smooth"
        ],
        "params": 0.05
      }
    },
    "scriptUniforms": {
      "script_time": "float"
    }
  },
  "license": "Third-party preview: original authors retain all rights; see the author field and source/ directory. Not relicensed by Blink."
}
