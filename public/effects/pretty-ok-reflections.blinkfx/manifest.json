{
  "format": "blinkfx/1",
  "id": "com.codexo.ssf.pretty_ok_reflections",
  "title": "Pretty ok reflections",
  "author": "mrange",
  "description": "Hypnotic geometric reflections that pulse and rotate with your music.",
  "thumbnail": "thumbnail.png",
  "tags": [
    "mrange",
    "reflections",
    "audio-reactive",
    "geometric",
    "interactive"
  ],
  "kind": "generator",
  "controls": [
    {
      "name": "mix_mode",
      "label": "mix mode",
      "description": "Media blend mode – 0=brightness, 1=alpha",
      "group": "Media",
      "type": "float",
      "default": 0.3,
      "min": 0,
      "max": 1
    },
    {
      "name": "media_opaque",
      "label": "media opaque",
      "description": "Media opacity – controls overlay blend strength",
      "group": "Media",
      "type": "float",
      "default": 1,
      "min": 0,
      "max": 1
    },
    {
      "name": "distortion",
      "label": "distortion",
      "description": "Ray distortion – warps and bends the scene",
      "group": "Visual",
      "type": "point2d",
      "default": [
        0,
        0
      ],
      "min": [
        -1,
        -1
      ],
      "max": [
        1,
        1
      ]
    },
    {
      "name": "rotation_speed_0",
      "label": "rotation speed 0",
      "description": "Primary rotation – spins geometry on first axis",
      "group": "Visual",
      "type": "float",
      "default": 0.123,
      "min": -1,
      "max": 1
    },
    {
      "name": "rotation_speed_1",
      "label": "rotation speed 1",
      "description": "Secondary rotation – spins geometry on second axis",
      "group": "Visual",
      "type": "float",
      "default": 0.234,
      "min": -1,
      "max": 1
    },
    {
      "name": "distance_z",
      "label": "distance z",
      "description": "Camera distance – controls zoom from reflections",
      "group": "Visual",
      "type": "float",
      "default": 4,
      "min": 2,
      "max": 7
    },
    {
      "name": "motion_mod",
      "label": "motion mod",
      "description": "Rotation modulation – adds wave motion to rotations",
      "group": "Visual",
      "type": "point2d",
      "default": [
        1,
        1
      ],
      "min": [
        0,
        0
      ],
      "max": [
        1,
        1
      ]
    },
    {
      "name": "bass_mod_z",
      "label": "bass mod z",
      "description": "Bass reactivity – camera pulses with bass audio",
      "group": "Visual",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1
    }
  ],
  "inputs": [
    {
      "name": "syn_Media",
      "type": "image",
      "required": false,
      "sampling": {
        "filter": "linear",
        "wrap": "mirror"
      }
    }
  ],
  "passes": [
    {
      "name": "main",
      "shader": "main",
      "inputs": [
        {
          "source": "blink.audio.spectrum",
          "uniform": "syn_Spectrum"
        },
        {
          "source": "input.syn_Media",
          "uniform": "syn_Media"
        }
      ],
      "target": "screen",
      "clear": true
    }
  ],
  "shaders": {
    "glsl": {
      "main": "shaders/main.frag.glsl"
    }
  },
  "script": {
    "entry": "script.js",
    "abi": "ssf/1"
  },
  "requirements": {
    "features": [
      "script:ssf/1"
    ]
  },
  "compatibility": {
    "source": {
      "format": "ssf",
      "version": "2.0"
    },
    "profile": "ssf/1",
    "mode": "preserve",
    "converter": "blinkfx-ssf-converter/1",
    "controls": {
      "mix_mode": {
        "format": "ssf",
        "type": "slider smooth",
        "modifiers": [
          "smooth"
        ],
        "params": 0.2
      },
      "media_opaque": {
        "format": "ssf",
        "type": "slider smooth",
        "modifiers": [
          "smooth"
        ],
        "params": 0.2
      },
      "distortion": {
        "format": "ssf",
        "type": "xy smooth",
        "modifiers": [
          "smooth"
        ],
        "params": 0.2
      },
      "rotation_speed_0": {
        "format": "ssf",
        "type": "slider speed",
        "modifiers": [
          "speed"
        ]
      },
      "rotation_speed_1": {
        "format": "ssf",
        "type": "slider speed",
        "modifiers": [
          "speed"
        ]
      },
      "distance_z": {
        "format": "ssf",
        "type": "slider smooth",
        "modifiers": [
          "smooth"
        ],
        "params": 0.2
      },
      "motion_mod": {
        "format": "ssf",
        "type": "xy smooth",
        "modifiers": [
          "smooth"
        ],
        "params": 0.2
      },
      "bass_mod_z": {
        "format": "ssf",
        "type": "slider smooth",
        "modifiers": [
          "smooth"
        ],
        "params": 0.2
      }
    }
  },
  "license": "Third-party preview: original authors retain all rights; see the author field and source/ directory. Not relicensed by Blink."
}
