    if(d<1e-3||z>MaxDistance) break;
    if(d<nd) {
      nd=d;
      nz=z;
    }
    z+=d;
  }

  if(i==max_iter) {
    z=nz;
  }

  return z;
}

vec3 render_inner_reflections(float A, vec3 RO, vec3 RI) {
