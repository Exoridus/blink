      }
    },
    "scriptUniforms": {
      "sunColor": "vec3",
      "topColor": "vec3",
      "glowColor0": "vec3",
      "glowColor2": "vec3",
      "diffColor": "vec3",
      "glowCol1": "vec3",
      "barCol": "vec3"
    }
  },
