{
  "format": "blinkfx/1",
  "id": "com.codexo.ssf.hextunnel",
  "title": "HexTunnel",
  "author": "sheltron",
  "description": "raymarch hex tunnel day3",
  "thumbnail": "thumbnail.png",
  "tags": [
    "raymarching",
    "tunnel",
    "dark",
    "media"
  ],
  "kind": "generator",
  "controls": [
    {
      "name": "media_scale",
      "label": "media scale",
      "description": "Use this scene with media!",
      "group": "USE MEDIA",
      "type": "float",
      "default": 0.5,
      "min": 0,
      "max": 1
    },
    {
      "name": "cam_Look",
      "label": "cam Look",
      "description": "Look around in the tunnel.",
      "group": "tunnel",
      "type": "point2d",
      "default": [
        3.14,
        3.14
      ],
      "min": [
        0,
        0
      ],
      "max": [
        6.28,
        6.28
      ]
    },
    {
      "name": "radius",
      "label": "radius",
      "description": "Radius of the tunnel. Too big and you may get noisy.",
      "group": "tunnel",
      "type": "float",
      "default": 0.6,
      "min": 0.1,
      "max": 0.9
    },
    {
      "name": "ripples",
      "label": "ripples",
      "description": "Add a simple smooth ripple distortion to the scene.",
      "group": "tunnel",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1
    },
    {
      "name": "Red",
      "label": "Red",
      "description": "Add a simple smooth ripple distortion to the scene.",
      "group": "color",
      "type": "float",
      "default": 1,
      "min": 0,
      "max": 1
    },
    {
      "name": "Green",
      "label": "Green",
      "description": "Add a simple smooth ripple distortion to the scene.",
      "group": "color",
      "type": "float",
      "default": 1,
      "min": 0,
      "max": 1
    },
    {
      "name": "Blue",
      "label": "Blue",
      "description": "Add a simple smooth ripple distortion to the scene.",
      "group": "color",
      "type": "float",
      "default": 1,
      "min": 0,
      "max": 1
    }
  ],
  "inputs": [
    {
      "name": "syn_Media",
      "type": "image",
      "required": false,
      "sampling": {
        "filter": "linear",
        "wrap": "repeat"
      }
    }
  ],
  "assets": [
    {
      "name": "image30",
      "type": "texture2d",
      "path": "assets/30.png",
      "sampling": {
        "filter": "mipmap",
        "wrap": "repeat"
      }
    }
  ],
  "passes": [
    {
      "name": "BuffA",
      "shader": "main",
      "inputs": [
        {
          "source": "target.BuffA.previous",
          "uniform": "BuffA"
        },
        {
          "source": "input.syn_Media",
          "uniform": "syn_Media"
        }
      ],
      "target": {
        "name": "BuffA",
        "width": 1920,
        "height": 1080,
        "format": "rgba32f",
        "sampling": {
          "filter": "linear",
          "wrap": "repeat"
        },
        "persistent": true
      },
      "clear": false
    },
    {
      "name": "final",
      "shader": "main",
      "inputs": [
        {
          "source": "target.BuffA",
          "uniform": "BuffA"
        },
        {
          "source": "input.syn_Media",
          "uniform": "syn_Media"
        }
      ],
      "target": "screen",
      "clear": true
    }
  ],
  "shaders": {
    "glsl": {
      "main": "shaders/main.frag.glsl"
    }
  },
  "script": {
    "entry": "script.js",
    "abi": "ssf/1"
  },
  "requirements": {
    "features": [
      "script:ssf/1"
    ]
  },
  "compatibility": {
    "source": {
      "format": "ssf",
      "version": "2.0"
    },
    "profile": "ssf/1",
    "mode": "preserve",
    "converter": "blinkfx-ssf-converter/1",
    "controls": {
      "media_scale": {
        "format": "ssf",
        "type": "slider smooth",
        "modifiers": [
          "smooth"
        ],
        "params": 0.1
      },
      "cam_Look": {
        "format": "ssf",
        "type": "xy smooth",
        "modifiers": [
          "smooth"
        ],
        "params": 0.01
      },
      "radius": {
        "format": "ssf",
        "type": "slider smooth",
        "modifiers": [
          "smooth"
        ],
        "params": 0.2
      },
      "ripples": {
        "format": "ssf",
        "type": "slider smooth",
        "modifiers": [
          "smooth"
        ],
        "params": 0.5
      },
      "Red": {
        "format": "ssf",
        "type": "slider smooth",
        "modifiers": [
          "smooth"
        ],
        "params": 0.5
      },
      "Green": {
        "format": "ssf",
        "type": "slider smooth",
        "modifiers": [
          "smooth"
        ],
        "params": 0.5
      },
      "Blue": {
        "format": "ssf",
        "type": "slider smooth",
        "modifiers": [
          "smooth"
        ],
        "params": 0.5
      }
    },
    "scriptUniforms": {
      "script_time": "float"
    }
  },
