        },
        {
          "source": "target.forHorBlur",
          "uniform": "forHorBlur"
        },
        {
          "source": "target.forVertBlur",
          "uniform": "forVertBlur"
        },
        {
          "source": "target.forLastPass",
          "uniform": "forLastPass"
        },
        {
          "source": "input.syn_UserImage",
          "uniform": "syn_UserImage"
