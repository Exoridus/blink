{
  "format": "blinkfx/1",
  "id": "com.codexo.ssf.compound_iris",
  "title": "Compound Iris",
  "author": "Meebs",
  "thumbnail": "thumbnail.png",
  "tags": [
    "2d",
    "geometric",
    "dark",
    "media"
  ],
  "kind": "generator",
  "controls": [
    {
      "name": "colored",
      "label": "colored",
      "description": "Change from pure white to one of three color palettes, with color palettes changing on transition.",
      "group": "color",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "invert",
      "label": "invert",
      "description": "Toggle between white on black or black on white.",
      "group": "color",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "motion_style",
      "label": "motion style",
      "description": "Two motion modes for the main shape: ON is a poppy motion that moves on the beat. When set to OFF it creates a slower moving, oscillating mandala.",
      "group": "rings",
      "type": "float",
      "default": 1,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "radius_ring",
      "label": "radius ring",
      "description": "Changes the radius of individual rings. Thin is an interesting look. Can be set very low for disappearing rings.",
      "group": "rings",
      "type": "float",
      "default": 1,
      "min": -5,
      "max": 9
    },
    {
      "name": "blur_amount",
      "label": "blur amount",
      "description": "Applies blur to the rings, reducing hard edges. Can be turned way up to 'blow up' the scene.",
      "group": "rings",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 3
    },
    {
      "name": "aberration",
      "label": "aberration",
      "description": "Control amount of chromatic aberration. The middle is 'none', top and bottom are full aberration amount in opposite directions.",
      "group": "optical",
      "type": "float",
      "default": 0,
      "min": -10,
      "max": 10
    },
    {
      "name": "refraction",
      "label": "refraction",
      "description": "Control amount of refraction through triangle surface. High refraction results in pretty colors but can lead to FPS lag. Bottom is none, top is full.",
      "group": "optical",
      "type": "float",
      "default": 1,
      "min": 0,
      "max": 10
    },
    {
      "name": "surface_pulse",
      "label": "surface pulse",
      "description": "Send a pulse through the triangle surface, shuffling around refracted light.",
      "group": "tri_surface",
      "type": "float",
      "default": 1,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "surface_fracture",
      "label": "surface fracture",
      "description": "Fracture the triangle surface, as if it had been shattered by a hit.",
      "group": "tri_surface",
      "type": "float",
      "default": 1,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "colorMode",
      "label": "colorMode",
      "type": "float",
      "default": 0,
      "group": "Transitions"
    },
    {
      "name": "refract_angle",
      "label": "refract angle",
      "type": "float",
      "default": 0,
      "group": "Transitions"
    },
    {
      "name": "zoomAmt",
      "label": "zoomAmt",
      "type": "float",
      "default": 0,
      "group": "Transitions"
    }
  ],
  "inputs": [
    {
      "name": "syn_UserImage",
      "type": "image",
      "required": false,
      "sampling": {
        "filter": "linear",
        "wrap": "repeat"
      }
    }
  ],
  "passes": [
    {
      "name": "firstBuffer",
      "shader": "main",
      "inputs": [
        {
          "source": "target.firstBuffer.previous",
          "uniform": "firstBuffer"
        },
        {
          "source": "target.secondBuffer.previous",
          "uniform": "secondBuffer"
        },
        {
          "source": "target.forHorBlur.previous",
          "uniform": "forHorBlur"
        },
        {
          "source": "target.forVertBlur.previous",
          "uniform": "forVertBlur"
        },
        {
          "source": "target.forLastPass.previous",
          "uniform": "forLastPass"
        },
        {
          "source": "input.syn_UserImage",
          "uniform": "syn_UserImage"
        }
      ],
      "target": {
        "name": "firstBuffer",
        "format": "rgba32f",
        "sampling": {
          "filter": "linear",
          "wrap": "repeat"
        },
        "persistent": true
      },
      "clear": false
    },
    {
