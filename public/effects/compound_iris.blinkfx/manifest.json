          "uniform": "firstBuffer"
        },
        {
          "source": "target.secondBuffer",
          "uniform": "secondBuffer"
        },
        {
          "source": "target.forHorBlur",
          "uniform": "forHorBlur"
        },
        {
          "source": "target.forVertBlur",
