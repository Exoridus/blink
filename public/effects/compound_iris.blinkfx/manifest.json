        {
          "source": "target.forLastPass.previous",
          "uniform": "forLastPass"
        },
        {
          "source": "input.syn_UserImage",
          "uniform": "syn_UserImage"
        }
      ],
      "target": {
        "name": "secondBuffer",
        "format": "rgba32f",
        "sampling": {
          "filter": "linear",
          "wrap": "repeat"
        },
        "persistent": true
