{
  "format": "blinkfx/1",
  "id": "com.codexo.ssf.voronoi_geode",
  "title": "Voronoi Geode",
  "author": "Shane",
  "thumbnail": "thumbnail.png",
  "tags": [
    "raymarching",
    "realistic"
  ],
  "kind": "generator",
  "controls": [
    {
      "name": "pulse",
      "label": "pulse",
      "description": "Causes a bright pulse to emanate from the center.",
      "group": "reactivity",
      "type": "float",
      "default": 1,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "speed_motion",
      "label": "speed motion",
      "description": "Affects the speed of the crystal gyration.",
      "group": "reactivity",
      "type": "float",
      "default": 2,
      "min": 0,
      "max": 5
    },
    {
      "name": "grid_growth",
      "label": "grid growth",
      "group": "reactivity",
      "type": "float",
      "default": 1,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "highs_shimmer",
      "label": "highs shimmer",
      "group": "reactivity",
      "type": "float",
      "default": 1,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "elevation",
      "label": "elevation",
      "description": "Zooms the camera in or out. Fully out causes it to take on a 'planetoid' look.",
      "group": "camera",
      "type": "float",
      "default": 0,
      "min": -1,
      "max": 1
    },
    {
      "name": "spinning",
      "label": "spinning",
      "description": "Whether or not the camera is rotating.",
      "group": "camera",
      "type": "float",
      "default": 1,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "alternate_crystals",
      "label": "alternate crystals",
      "description": "OFF: Standard, angular crystals. ON: Grid-like crystals using the manhattan distance.",
      "group": "geometry",
      "type": "float",
      "default": 1,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "rot_distort",
      "label": "rot distort",
      "description": "Deforms the surface, distorting the edges in glitchy ways.",
      "group": "geometry",
      "type": "float",
      "default": 0,
      "min": -0.1,
      "max": 0.1
    },
    {
      "name": "red_geode",
      "label": "red geode",
      "description": "Default, geode-looking red texture. TURN OFF to use other backgrounds.",
      "group": "background",
      "type": "float",
      "default": 1,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "green_circuits",
      "label": "green circuits",
      "description": "Green, circuit-like texture. TURN OFF to use other backgrounds.",
      "group": "background",
      "type": "float",
      "default": 1,
      "min": 0,
      "max": 1,
      "step": 1
    }
  ],
  "inputs": [
    {
      "name": "syn_Media",
      "type": "image",
      "required": false,
      "sampling": {
        "filter": "linear",
        "wrap": "repeat"
      }
    }
  ],
  "assets": [
    {
      "name": "agate2",
      "type": "texture2d",
      "path": "assets/agate2.jpg",
      "sampling": {
        "filter": "mipmap",
        "wrap": "repeat"
      }
    },
    {
      "name": "agate1",
      "type": "texture2d",
      "path": "assets/agate1.jpg",
      "sampling": {
        "filter": "mipmap",
        "wrap": "repeat"
      }
    }
  ],
  "passes": [
    {
      "name": "main",
      "shader": "main",
      "inputs": [
        {
          "source": "asset.agate2",
          "uniform": "agate2"
        },
        {
          "source": "asset.agate1",
          "uniform": "agate1"
        },
        {
          "source": "input.syn_Media",
          "uniform": "syn_Media"
        }
      ],
      "target": "screen",
      "clear": true
    }
  ],
  "shaders": {
    "glsl": {
      "main": "shaders/main.frag.glsl"
    }
  },
  "script": {
    "entry": "script.js",
    "abi": "ssf/1"
  },
  "requirements": {
    "features": [
      "script:ssf/1"
    ]
  },
  "compatibility": {
    "source": {
      "format": "ssf",
      "version": "2.0"
    },
    "profile": "ssf/1",
    "mode": "preserve",
    "converter": "blinkfx-ssf-converter/1",
    "controls": {
      "pulse": {
        "format": "ssf",
        "type": "bang smooth",
        "modifiers": [
          "smooth"
        ],
        "params": 0.01
      },
      "speed_motion": {
        "format": "ssf",
        "type": "slider",
        "modifiers": []
      },
      "grid_growth": {
        "format": "ssf",
        "type": "toggle",
        "modifiers": []
      },
      "highs_shimmer": {
        "format": "ssf",
        "type": "toggle",
        "modifiers": []
      },
      "elevation": {
        "format": "ssf",
        "type": "slider smooth",
        "modifiers": [
          "smooth"
        ],
        "params": 0.025
      },
      "spinning": {
        "format": "ssf",
        "type": "toggle",
        "modifiers": []
      },
      "alternate_crystals": {
        "format": "ssf",
        "type": "toggle",
        "modifiers": []
      },
      "rot_distort": {
        "format": "ssf",
        "type": "slider smooth",
        "modifiers": [
          "smooth"
        ],
        "params": 0.1
      },
      "red_geode": {
        "format": "ssf",
        "type": "toggle",
        "modifiers": []
      },
      "green_circuits": {
        "format": "ssf",
        "type": "toggle",
        "modifiers": []
      }
    },
    "scriptUniforms": {
      "script_time": "float"
    }
  },
