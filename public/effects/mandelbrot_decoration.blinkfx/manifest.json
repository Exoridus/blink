{
  "format": "blinkfx/1",
  "id": "com.codexo.ssf.mandelbrot_decoration",
  "title": "Mandelbrot Decoration",
  "author": "Shane",
  "description": "Applying a simple pattern and coloring to a standard iterative Mandelbrot transformation.",
  "thumbnail": "thumbnail.png",
  "tags": [
    "fractal",
    "media",
    "infinite",
    "psychedelic"
  ],
  "kind": "generator",
  "controls": [
    {
      "name": "navigate",
      "label": "navigate",
      "description": "Move camera to explore the fractal",
      "group": "camera",
      "type": "point2d",
      "default": [
        0,
        0
      ],
      "min": [
        -1,
        -1
      ],
      "max": [
        1,
        1
      ]
    },
    {
      "name": "constant_rotate",
      "label": "constant rotate",
      "description": "Camera will constantly be slowly rotating",
      "group": "camera",
      "type": "float",
      "default": 1,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "auto_camera_jumps",
      "label": "auto camera jumps",
      "description": "Camera will automatically jump around on the beat",
      "group": "camera",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "random_camera",
      "label": "random camera",
      "description": "Manually do a random camera jump",
      "group": "camera",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "zoom",
      "label": "zoom",
      "description": "Zoom in or out of the fractal",
      "group": "camera",
      "type": "float",
      "default": 1.4,
      "min": 0,
      "max": 10
    },
    {
      "name": "media_xy",
      "label": "media xy",
      "description": "Move the media around within the fractal",
      "group": "media",
      "type": "point2d",
      "default": [
        0,
        0
      ],
      "min": [
        -1,
        -1
      ],
      "max": [
        1,
        1
      ]
    },
    {
      "name": "media_style",
      "label": "media style",
      "description": "Media appears in flat layers or branching curves",
      "group": "media",
      "type": "float",
      "default": 1,
      "min": 1,
      "max": 1,
      "step": 1
    },
    {
      "name": "sub_pattern",
      "label": "sub pattern",
      "description": "Subtract the grid pattern from the media",
      "group": "media",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "grid",
      "label": "grid",
      "description": "Affect the grid shape",
      "group": "shape",
      "type": "float",
      "default": 1,
      "min": 0.001,
      "max": 3
    },
    {
      "name": "bubbling",
      "label": "bubbling",
      "description": "Subtle morphing of the fractal shape for extra action",
      "group": "shape",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "minimal",
      "label": "minimal",
      "description": "Remove the grid pattern and reflections",
      "group": "shape",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "pulser",
      "label": "pulser",
      "description": "Send a smooth white pulse down",
      "group": "action",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "pulse2",
      "label": "pulse2",
      "description": "Send a black/white pulse down",
      "group": "action",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "flasher_on",
      "label": "flasher on",
      "description": "Flasher rising up in sync with the beat",
      "group": "action",
      "type": "float",
      "default": 1,
      "min": 0,
      "max": 1,
      "step": 1
    }
  ],
  "inputs": [
    {
      "name": "syn_Media",
      "type": "image",
      "required": false,
      "sampling": {
        "filter": "linear",
        "wrap": "repeat"
      }
    }
  ],
  "passes": [
    {
      "name": "main",
      "shader": "main",
      "inputs": [
        {
          "source": "input.syn_Media",
          "uniform": "syn_Media"
        }
      ],
      "target": "screen",
      "clear": true
    }
  ],
  "shaders": {
    "glsl": {
      "main": "shaders/main.frag.glsl"
    }
  },
  "script": {
    "entry": "script.js",
    "abi": "ssf/1"
