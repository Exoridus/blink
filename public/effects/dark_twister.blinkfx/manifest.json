      "group": "Effects",
      "type": "float",
      "default": 5,
      "min": 0.5,
      "max": 10
    },
    {
      "name": "flash_radius",
      "label": "flash radius",
      "description": "Flash sphere radius (X: off-beat size, Y: on-beat size)",
      "group": "Effects",
      "type": "point2d",
      "default": [
        1,
        2
      ],
      "min": [
        0.001,
        0.001
      ],
      "max": [
        5,
        5
      ]
    },
    {
      "name": "motion_blur",
      "label": "motion blur",
      "description": "Frame blending amount (0 = sharp, 1 = heavy trails)",
      "group": "Effects",
      "type": "float",
      "default": 0.3,
      "min": 0,
      "max": 0.88
    },
    {
      "name": "ref_focus",
      "label": "ref focus",
      "description": "Specular highlight sharpness (higher = tighter hotspot)",
      "group": "Effects",
      "type": "float",
      "default": 190,
      "min": 1,
      "max": 300
    },
    {
      "name": "ref_factor",
      "label": "ref factor",
      "description": "Specular reflection brightness multiplier",
      "group": "Effects",
      "type": "float",
      "default": 0.1,
      "min": 0,
      "max": 1
    },
    {
      "name": "camera_swing",
      "label": "camera swing",
      "description": "Path wave amplitude (X and Y control horizontal/vertical swing)",
      "group": "Shape",
      "type": "point2d",
      "default": [
        6,
        4
      ],
      "min": [
        -9,
        -9
      ],
      "max": [
        9,
        9
      ]
    },
    {
      "name": "rotation_speed",
      "label": "rotation speed",
