      "description": "Media opacity – fade visuals in or out",
      "group": "Media",
      "type": "float",
      "default": 0.4,
      "min": 0,
      "max": 1
    },
    {
      "name": "media_depth",
      "label": "media depth",
      "description": "Limit media to nearby camera or allow full depth",
      "group": "Media",
      "type": "float",
      "default": 0.35,
      "min": 0,
      "max": 1
    },
    {
      "name": "media_displacement",
      "label": "media displacement",
      "description": "Change how much media is displaced by geometry",
      "group": "Media",
      "type": "float",
      "default": 1,
      "min": -2,
      "max": 2
    }
  ],
  "inputs": [
    {
      "name": "syn_Media",
      "type": "image",
      "required": false,
      "sampling": {
        "filter": "linear",
        "wrap": "mirror"
      }
    }
  ],
  "passes": [
    {
      "name": "main",
      "shader": "main",
      "inputs": [
        {
          "source": "input.syn_Media",
          "uniform": "syn_Media"
        },
        {
          "source": "target.syn_FinalBuffer.previous",
          "uniform": "syn_FinalPass"
        }
      ],
      "target": {
        "name": "syn_FinalBuffer",
        "format": "rgba8",
        "persistent": true
      },
      "clear": true
    },
    {
      "name": "present",
      "shader": "present",
      "inputs": [
        {
          "source": "target.syn_FinalBuffer",
          "uniform": "present_source"
        }
      ],
      "target": "screen",
      "clear": true
    }
  ],
  "shaders": {
    "glsl": {
      "main": "shaders/main.frag.glsl",
      "present": "shaders/present.frag.glsl"
    }
  },
  "script": {
