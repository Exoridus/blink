      "label": "beam lum",
      "description": "Brightness multiplier for fractal beam glow",
      "group": "Color",
      "type": "float",
      "default": 0.5,
      "min": 0,
      "max": 3
    },
    {
      "name": "beam_rate",
      "label": "beam rate",
      "group": "Color",
      "type": "float",
      "default": -0.1,
      "min": -1,
      "max": 1
