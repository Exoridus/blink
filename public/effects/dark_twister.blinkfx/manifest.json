{
  "format": "blinkfx/1",
  "id": "com.codexo.ssf.dark_twister",
  "title": "Dark Twister",
  "author": "mrange",
  "description": "Plunge into the Dark Twister—a mesmerizing journey through a spiraling vortex of neon light and shadow. Recursive fractal geometry twists and folds through infinite space, creating a tunnel of electric blue and vibrant magenta beams that pulse and flash with the music. A glowing sphere of energy leads the way, casting dramatic reflections across the sleek, dark surfaces. The entire structure warps along a sinuous path while audio-reactive elements make every bass hit intensify the flash and twist the geometry deeper. Perfect for dark techno, bass music, and atmospheric sets where mysterious beauty meets raw energy.",
  "thumbnail": "thumbnail.png",
  "tags": [
    "mrange",
    "dark",
    "twister",
    "vortex",
    "tunnel",
    "audio-reactive",
    "bass-reactive",
    "neon",
    "spiral",
    "recursive",
    "raymarch",
    "mysterious"
  ],
  "kind": "generator",
  "controls": [
    {
      "name": "bass_mix",
      "label": "bass mix",
      "description": "Audio response strength (X: bass level, Y: bass hits)",
      "group": "Audio",
      "type": "point2d",
      "default": [
        0.7,
        0.7
      ],
      "min": [
        0,
        0
      ],
      "max": [
        1,
        1
      ]
    },
    {
      "name": "bass_pow",
      "label": "bass pow",
      "description": "Audio response curve (higher = more intense reaction)",
      "group": "Audio",
      "type": "float",
      "default": 3,
      "min": 0,
      "max": 6
    },
    {
      "name": "flash_mix",
      "label": "flash mix",
      "description": "Flash brightness (X: off-beat intensity, Y: on-beat intensity)",
      "group": "Effects",
      "type": "point2d",
      "default": [
        0.5,
        5
      ],
      "min": [
        0,
        0
      ],
      "max": [
        9,
        9
      ]
    },
    {
      "name": "flash_dist",
      "label": "flash dist",
