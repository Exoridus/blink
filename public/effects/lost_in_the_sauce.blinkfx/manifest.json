{
  "format": "blinkfx/1",
  "id": "com.codexo.ssf.lost_in_the_sauce",
  "title": "Lost in the Sauce",
  "author": "Keijiro Takahashi x Meebs",
  "thumbnail": "thumbnail.png",
  "tags": [
    "feedback",
    "media",
    "groovy",
    "colorful"
  ],
  "kind": "generator",
  "controls": [
    {
      "name": "synced_twitcher",
      "label": "synced twitcher",
      "description": "Make the sauce twitch rhythmically",
      "group": "time",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "hue_adjust",
      "label": "hue adjust",
      "description": "Hue rotate the main color palette",
      "group": "coloration",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1
    },
    {
      "name": "mode_2",
      "label": "mode 2",
      "description": "Monochrome flash on beat",
      "group": "coloration",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "pixel_garbage",
      "label": "pixel garbage",
      "description": "Degenerate the sauce into pixel garbage",
      "group": "coloration",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "feedback_amt",
      "label": "feedback amt",
      "description": "Amount of feedback the sauce has",
      "group": "feedback",
      "type": "float",
      "default": 1,
      "min": 0.01,
      "max": 2
    },
    {
      "name": "iterations",
      "label": "iterations",
      "description": "Number of iterations of the sauce",
      "group": "feedback",
      "type": "float",
      "default": 1,
      "min": 0.005,
      "max": 1
    },
    {
      "name": "scale",
      "label": "scale",
      "description": "How big or small is the sauce",
      "group": "feedback",
      "type": "float",
      "default": 0.5,
      "min": 0,
      "max": 1
    },
    {
      "name": "feed_thickness",
      "label": "feed thickness",
      "description": "Thickness of the lines that feed the sauce",
      "group": "feedback",
      "type": "float",
      "default": 0.5,
      "min": 0,
      "max": 1
    },
    {
      "name": "media_feeder",
      "label": "media feeder",
      "description": "Add the media to the feedback",
      "group": "media",
      "type": "float",
      "default": 1,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "media_mask",
      "label": "media mask",
      "description": "Mask the feedback with the media",
      "group": "media",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1
    },
    {
      "name": "media_refract",
      "label": "media refract",
      "description": "Change feedback based on brightness of media",
      "group": "media",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1
    },
    {
      "name": "media_color",
      "label": "media color",
      "description": "Add the media colors into the sauce",
      "group": "media",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1
    },
    {
      "name": "media_subtract",
      "label": "media subtract",
      "description": "Subtract the media from the sauce",
      "group": "media",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 2
    }
  ],
  "inputs": [
    {
      "name": "syn_Media",
      "type": "image",
      "required": false,
      "sampling": {
        "filter": "linear",
        "wrap": "repeat"
      }
    }
  ],
  "passes": [
    {
      "name": "feedback",
      "shader": "main",
      "inputs": [
        {
          "source": "target.feedback.previous",
          "uniform": "feedback"
        },
        {
          "source": "target.finalPass.previous",
          "uniform": "finalPass"
        },
        {
          "source": "input.syn_Media",
          "uniform": "syn_Media"
        }
      ],
      "target": {
        "name": "feedback",
        "width": 2176,
        "height": 1224,
        "format": "rgba32f",
        "sampling": {
          "filter": "linear",
          "wrap": "repeat"
        },
        "persistent": true
      },
      "clear": false
    },
    {
      "name": "finalPass",
      "shader": "main",
      "inputs": [
        {
          "source": "target.feedback",
          "uniform": "feedback"
        },
        {
          "source": "target.finalPass.previous",
          "uniform": "finalPass"
        },
        {
          "source": "input.syn_Media",
          "uniform": "syn_Media"
        }
      ],
      "target": {
        "name": "finalPass",
        "format": "rgba32f",
        "sampling": {
          "filter": "linear",
          "wrap": "repeat"
        },
        "persistent": true
      },
      "clear": false
    },
    {
      "name": "final",
      "shader": "main",
      "inputs": [
        {
          "source": "target.feedback",
          "uniform": "feedback"
        },
        {
          "source": "target.finalPass",
          "uniform": "finalPass"
        },
        {
          "source": "input.syn_Media",
          "uniform": "syn_Media"
        }
      ],
      "target": "screen",
      "clear": true
    }
  ],
  "shaders": {
    "glsl": {
      "main": "shaders/main.frag.glsl"
    }
  },
  "compatibility": {
    "source": {
      "format": "ssf",
      "version": "2.0"
    },
    "profile": "ssf/1",
    "mode": "preserve",
    "converter": "blinkfx-ssf-converter/1",
    "controls": {
