float beat() {



  return dot(pow(vec2(syn_BassLevel,syn_BassHits), bass_pow), bass_mix);

}


float g(vec4 p,float s) {
  return abs(dot(sin(p*=s),cos(p.zxwy))-1.)/s;
}

mat2 rot(float a) {
  float c=cos(a),s=sin(a);
  return mat2(c,s,-s,c);
}

vec4 renderMain() {
  vec2
    S=spiral_col_twist
  , Q=spiral_dim
  ;
  vec3
    I=normalize(vec3(_uvc,1.0))
  , O=vec3(0.0)
  ;
  float
      z=0.
    , B=beat()
    , Y
    , D
    , d=double_spiral
    , W=spiral_twist





    , T=path_speed
    , R=spiral_rot
    , C=color_rot

    , L=length(-1.+2.*_uv)
    ;
  vec4
      p
    , X
    , U=vec4(spiral_col_xy,spiral_col_zw)
    , M
    ;
  for(
      int i=0
    ; i<77
    ; ++i
    ) {
    p=z*I.xyzy;
    p.z+=T;
    D=g(p,23.) + g(p,11.) + g(p,7.);
    p.xy*=rot(R+W*p.z);
    Y=Q.x+Q.y*sin(.5*p.z);
    X=d>.5?abs(p):p;
    X/=Y;
    z+=D=.7*abs(Y*abs(X.x-round(max(X.x, 1.)))+D/9.-.1)+1e-3;
    D*=1.+dot(p.xy,p.xy)/4.;
    p=1.+sin(dot(S,p.xy)+(p.x<0.?C+.25+U.yzwy : U.zyxz-.25-C));
    O+=p.w/D*p.xyz;
  }
  O=
      B*border_mix.y*flash_col.rgb*smoothstep(border_glow.x,border_glow.y, L)
    + mix(1.,smoothstep(border_fade.x,border_fade.y, L), border_mix.x)
    * tanh((O+z*z*z*6.*flash_col.rgb)/9e3)
    ;



  M=_loadMedia();
  O=mix(O,M.xyz,M.w*media_opacity*media_multiplier);


  return vec4(O,1.0);
}


void main(void) {
  _xy = gl_FragCoord.xy;
  _uv = _xy / RENDERSIZE;
