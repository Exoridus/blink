{
  "format": "blinkfx/1",
  "id": "com.codexo.ssf.fractilian_foundation",
  "title": "Fractilian Foundation",
  "author": "mojovideotech",
  "description": "FractilianFoundation",
  "thumbnail": "thumbnail.png",
  "tags": [
    "fractal",
    "kaleidoscope",
    "feedback",
    "psychedelic",
    "groovy"
  ],
  "kind": "generator",
  "controls": [
    {
      "name": "feedback",
      "label": "feedback",
      "description": "adds basic feedback to the scene",
      "group": "distortion",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1
    },
    {
      "name": "barrel_distortion",
      "label": "barrel distortion",
      "description": "Distorts the fractal and adds a vignette",
      "group": "distortion",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1
    },
    {
      "name": "detail",
      "label": "detail",
      "description": "This adds more variation to the fractal color. Turning it up all the way will create a lot of 'rings'",
      "group": "fractal",
      "type": "float",
      "default": 0.97,
      "min": 0.9,
      "max": 0.9999
    },
    {
      "name": "fractal_softness",
      "label": "fractal softness",
      "description": "Create a softer or harder edge with the fractal coloration",
      "group": "fractal",
      "type": "float",
      "default": 1,
      "min": 1,
      "max": 1
    },
    {
      "name": "auto_rotate",
      "label": "auto rotate",
      "description": "Add manual rotation to the fractal. This is helpful if you want to control the intensity of the rotation",
      "group": "rotate",
      "type": "float",
      "default": 1,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "rotate",
      "label": "rotate",
      "description": "Add manual rotation to the fractal. This is helpful if you want to control the intensity of the rotation",
      "group": "rotate",
      "type": "float",
      "default": 0,
      "min": -1,
      "max": 1
    },
    {
      "name": "zoom",
      "label": "zoom",
      "description": "Zoom in on the fractal",
      "group": "camera",
      "type": "float",
      "default": 1.5,
      "min": 0.5,
      "max": 3
    },
    {
      "name": "camera_position",
      "label": "camera position",
      "description": "Move the position of the fractal",
      "group": "camera",
      "type": "point2d",
      "default": [
        0,
        0
      ],
      "min": [
        -1,
        -1
      ],
      "max": [
        1,
        1
      ]
    },
    {
      "name": "color_regime",
      "label": "color regime",
      "description": "Choose from one of 3 color palettes.",
      "group": "colorize",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1
    },
    {
      "name": "colorModifier",
      "label": "colorModifier",
      "description": "Flip the color scheme",
      "group": "colorize",
      "type": "float",
      "default": 1,
      "min": 0,
      "max": 1
    },
    {
      "name": "color_beat_pulse",
      "label": "color beat pulse",
      "description": "pulses color to the beat.",
      "group": "colorize",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1,
      "step": 1
    }
  ],
  "inputs": [
    {
      "name": "syn_Media",
      "type": "image",
      "required": false,
      "sampling": {
        "filter": "linear",
        "wrap": "repeat"
      }
    }
  ],
  "passes": [
    {
      "name": "BuffA",
      "shader": "main",
      "inputs": [
        {
          "source": "target.BuffA.previous",
          "uniform": "BuffA"
        },
        {
          "source": "input.syn_Media",
          "uniform": "syn_Media"
        }
      ],
      "target": {
        "name": "BuffA",
        "width": 1920,
        "height": 1080,
        "format": "rgba32f",
        "sampling": {
          "filter": "linear",
          "wrap": "repeat"
        },
        "persistent": true
      },
      "clear": false
    },
    {
      "name": "final",
      "shader": "main",
      "inputs": [
        {
          "source": "target.BuffA",
          "uniform": "BuffA"
        },
        {
          "source": "input.syn_Media",
          "uniform": "syn_Media"
        }
      ],
      "target": "screen",
      "clear": true
    }
  ],
  "shaders": {
    "glsl": {
      "main": "shaders/main.frag.glsl"
    }
  },
  "compatibility": {
    "source": {
      "format": "ssf",
      "version": "2.0"
    },
    "profile": "ssf/1",
    "mode": "preserve",
    "converter": "blinkfx-ssf-converter/1",
    "controls": {
      "feedback": {
        "format": "ssf",
        "type": "slider smooth",
        "modifiers": [
          "smooth"
        ],
        "params": 0.05
      },
      "barrel_distortion": {
        "format": "ssf",
        "type": "slider smooth",
        "modifiers": [
          "smooth"
        ],
        "params": 0.01
      },
      "detail": {
        "format": "ssf",
        "type": "slider smooth",
        "modifiers": [
          "smooth"
        ],
        "params": 0.01
      },
      "fractal_softness": {
        "format": "ssf",
        "type": "slider smooth",
        "modifiers": [
          "smooth"
        ],
        "params": 0.05
      },
      "auto_rotate": {
        "format": "ssf",
        "type": "toggle",
        "modifiers": []
      },
      "rotate": {
        "format": "ssf",
        "type": "knob traveler",
        "modifiers": [
          "traveler"
        ],
        "params": 0.001
      },
      "zoom": {
        "format": "ssf",
        "type": "slider smooth",
        "modifiers": [
          "smooth"
        ],
        "params": 0.01
      },
      "camera_position": {
        "format": "ssf",
        "type": "xy smooth",
        "modifiers": [
          "smooth"
        ],
        "params": 0.01
      },
      "color_regime": {
        "format": "ssf",
        "type": "slider",
        "modifiers": []
      },
      "colorModifier": {
        "format": "ssf",
        "type": "slider smooth",
        "modifiers": [
          "smooth"
        ],
        "params": 0.01
      },
      "color_beat_pulse": {
        "format": "ssf",
        "type": "toggle smooth",
        "modifiers": [
          "smooth"
        ],
        "params": 0.01
      }
    }
  },
  "license": "Third-party preview: original authors retain all rights; see the author field and source/ directory. Not relicensed by Blink."
}
