vec3 _palette(in float t, in vec3 a, in vec3 b, in vec3 c, in vec3 d) {
  return a + b*cos( 6.28318*(c*t+d) );
}

bool _isMediaActive() {
  return syn_MediaType > 0.5;
}

vec2 _applyMediaScale(vec2 uv) {
  return (uv - 0.5) / pow(2., (_Media_Scale - 1.) * 5.) + 0.5;
}

float _ratioFix(float wr, float hr) {
  return _Fit_or_Fill > 0.5 ? max(wr, hr) : min(wr, hr);
}

vec2 _correctImageCoords(vec2 imageSize, vec2 uv) {
  float wr = RENDERSIZE.x/imageSize.x;
  float hr = RENDERSIZE.y/imageSize.y;
  float ratio = _ratioFix(wr, hr);
  vec2 correctedUv = uv;
  correctedUv.y *= hr/ratio;
  correctedUv.x *= wr/ratio;
  correctedUv.x += -wr/ratio/2.0 + 0.5;
  correctedUv.y += -hr/ratio/2.0 + 0.5;
  return correctedUv;
}
vec2 _correctImageCoords(vec2 imageSize){
  return _correctImageCoords(imageSize, _uv);
}

float _inRange(float value, float minimum, float maximum) {
  return step(minimum, value) - step(maximum, value);
}
float _inRange(vec2 value, float minimum, float maximum) {
  return _inRange(value.x, minimum, maximum) * _inRange(value.y, minimum, maximum);
}
float _inRange(vec3 value, float minimum, float maximum) {
  return _inRange(value.x, minimum, maximum) * _inRange(value.y, minimum, maximum) * _inRange(value.z, minimum, maximum);
}
float _inRange(vec4 value, float minimum, float maximum) {
  return _inRange(value.x, minimum, maximum) * _inRange(value.y, minimum, maximum) * _inRange(value.z, minimum, maximum) * _inRange(value.w, minimum, maximum);
}
float _inRange(float value) {
  return _inRange(value, 0.0, 1.0);
}
float _inRange(vec2 value) {
  return _inRange(value, 0.0, 1.0);
}
float _inRange(vec3 value) {
  return _inRange(value, 0.0, 1.0);
}
float _inRange(vec4 value) {
  return _inRange(value, 0.0, 1.0);
}

vec4 _loadMedia() {
  vec2 uv = _applyMediaScale(_correctImageCoords(vec2(textureSize(syn_Media, 0))));
  if (_inRange(uv, 0.0, 1.0) < 0.5) return vec4(0.0);
  return texture(syn_Media, uv);
}
vec4 _loadMedia(vec2 offset) {
  vec2 uv = _applyMediaScale(_correctImageCoords(vec2(textureSize(syn_Media, 0))));
  if (_inRange(uv + offset, 0.0, 1.0) < 0.5) return vec4(0.0);
  return texture(syn_Media, uv + offset);
}
vec4 _loadMedia(float lod) {
  vec2 uv = _applyMediaScale(_correctImageCoords(vec2(textureSize(syn_Media, int(lod)))));
  if (_inRange(uv, 0.0, 1.0) < 0.5) return vec4(0.0);
  return textureLod(syn_Media, uv, lod);
}
vec4 _loadMedia(vec2 offset, float lod) {
  vec2 uv = _applyMediaScale(_correctImageCoords(vec2(textureSize(syn_Media, int(lod)))));
  if (_inRange(uv + offset, 0.0, 1.0) < 0.5) return vec4(0.0);
  return textureLod(syn_Media, uv + offset, lod);
}
vec4 _textureMedia(vec2 uv) {
  uv = _applyMediaScale(_correctImageCoords(vec2(textureSize(syn_Media, 0)), uv));
  return texture(syn_Media, uv);
}
vec4 _textureMedia(vec2 uv, float lod) {
  uv = _applyMediaScale(_correctImageCoords(vec2(textureSize(syn_Media, int(lod))), uv));
  return texture(syn_Media, uv, lod);
}

float _pulse(float variable, float center, float width){
  return (smoothstep(center-width, center, variable)-(smoothstep(center, center+width, variable)));
}

vec3 _rgb2hsv(vec3 c) {
  vec4 K = vec4(0.0, -1.0 / 3.0, 2.0 / 3.0, -1.0);
  vec4 p = mix(vec4(c.bg, K.wz), vec4(c.gb, K.xy), step(c.b, c.g));
  vec4 q = mix(vec4(p.xyw, c.r), vec4(c.r, p.yzx), step(p.x, c.r));
  float d = q.x - min(q.w, q.y);
  float e = 1.0e-10;
  return vec3(abs(q.z + (q.w - q.y) / (6.0 * d + e)), d / (q.x + e), q.x);
}

vec3 _hsv2rgb(vec3 c) {
  vec4 K = vec4(1.0, 2.0 / 3.0, 1.0 / 3.0, 3.0);
  vec3 p = abs(fract(c.xxx + K.xyz) * 6.0 - K.www);
  return c.z * mix(K.xxx, clamp(p - K.xxx, 0.0, 1.0), c.y);
}

vec3 _gamma(vec3 color, float gamma){
  color.rgb = pow(color.rgb, 1.0/vec3(gamma));
  return color;
}
vec4 _gamma(vec4 color, float gamma){
  color.rgb = _gamma(color.rgb, gamma);
  return color;
}
