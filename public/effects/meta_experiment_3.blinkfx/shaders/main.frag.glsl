}
float e9(vec2 uv, float a, float p, float t) // ok
{
    vec2 uvSin = 0.3/dot(uv.xyyx,uv.yxxy) * vec2(cos(uv.y*p-t)*x_amp/p,sin(uv.x*p-t)*y_amp*p)/a;
   	return dot(uvSin.xyxy,uvSin.yxxy)/1.2;
