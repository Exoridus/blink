float e10(vec2 uv, float a, float p, float t) // ok
{
    vec2 uvSin = 0.3/dot(uv.xxy,uv.yxx) / vec2(cos(uv.y*p)*p*x_amp,sin(uv.x*p-t)*y_amp/p)/a;
