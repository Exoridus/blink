        "height": 1920,
        "format": "rgba32f",
        "sampling": {
          "filter": "linear",
          "wrap": "repeat"
        },
        "persistent": true
      },
      "clear": false
    },
    {
      "name": "final",
      "shader": "main",
      "inputs": [
        {
          "source": "target.fb0",
          "uniform": "fb0"
        },
        {
          "source": "target.fb1",
          "uniform": "fb1"
        },
        {
          "source": "input.syn_Media",
          "uniform": "syn_Media"
        }
      ],
      "target": "screen",
      "clear": true
    }
  ],
