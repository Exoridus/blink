      "description": "modulates spin rate of zoetrope effect",
      "group": "zoetrope",
      "type": "float",
      "default": 0,
      "min": -1,
      "max": 1
    },
    {
      "name": "glitch",
      "label": "glitch",
      "description": "how color behaves with extreme settings of 'lighten'",
      "group": "color",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "reverse",
      "label": "reverse",
      "description": "reverse spin (may not be visible with high 'density')",
