      "description": "audio modulates peak",
      "group": "shape, etc",
      "type": "float",
      "default": 1,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "auto_push",
      "label": "auto push",
      "description": "audio modulates vertical motion",
      "group": "shape, etc",
      "type": "float",
      "default": 1,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "auto_density",
      "label": "auto density",
      "description": "audio modulates density",
