      "group": "color",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "dark",
      "label": "dark",
      "description": "affects palette and 'density' behavior",
      "group": "color",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "warp",
      "label": "warp",
      "description": "color-based displacement",
      "group": "color",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "hue_range",
      "label": "hue range",
