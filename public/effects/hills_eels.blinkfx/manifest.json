      "name": "fb0",
      "shader": "main",
      "inputs": [
        {
          "source": "target.fb0.previous",
          "uniform": "fb0"
        },
        {
          "source": "target.fb1.previous",
          "uniform": "fb1"
        },
        {
          "source": "input.syn_Media",
          "uniform": "syn_Media"
        }
      ],
      "target": {
        "name": "fb0",
        "width": 1920,
        "height": 1920,
        "format": "rgba32f",
        "sampling": {
          "filter": "linear",
          "wrap": "repeat"
        },
        "persistent": true
      },
      "clear": false
    },
    {
      "name": "fb1",
      "shader": "main",
      "inputs": [
        {
          "source": "target.fb0",
          "uniform": "fb0"
        },
        {
