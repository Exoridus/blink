      "type": "float",
      "default": 0.5,
      "min": 0,
      "max": 1
    },
    {
      "name": "rate",
      "label": "rate",
      "description": "strobing rate of zoetrope effect",
      "group": "zoetrope",
      "type": "float",
      "default": 0.8,
      "min": 0,
      "max": 1
    },
    {
