  _xy = gl_FragCoord.xy;
  _uv = _xy / RENDERSIZE;
  _uvc = _xy / RENDERSIZE.y - vec2(RENDERSIZE.x / RENDERSIZE.y / 2.0, 0.5);
  time = syn_Time*0.5;
  volume = syn_Hits;
  brightness = syn_HighHits;
  onBeat = syn_OnBeat;
  bassAccum = syn_BassLevel;
  speedTime = syn_Time * 0.3;
  bassTime = syn_BassTime * 0.3;
  randomizerBeat = syn_ToggleOnBeat;
  resolution = RENDERSIZE;
  WIDTH = 888.0;
  HEIGHT = 500.0;
  reg1 = ColorRegime(vec3(1.0,0.7,0.25), vec3(0.8, 0.8, 1.0));
  reg2 = ColorRegime(vec3(0.9,0.1,0.45), vec3(0.3,0.02,0.15));
  reg3 = ColorRegime(vec3(0.0,0.3,0.7), vec3(0.7, 0.7, 1.0));
  reg4 = ColorRegime(vec3(0.5,0.2,0.0), vec3(0.9, 0.8, 0.65));
  reg5 = ColorRegime(vec3(0.0,0.7,0.0), vec3(0.2, 0.6, 1.0));
  WAVESPEED = 0.2+0.05*cos((1.0-volume)*PI) + WAVE_SPEED;
  fragColor = renderMain();
}
