{
  "format": "blinkfx/1",
  "id": "com.codexo.ssf.square_shoals",
  "title": "SquareShoals",
  "author": "Alex Rowe",
  "thumbnail": "thumbnail.jpg",
  "tags": [
    "media",
    "feedback",
    "dark",
    "abstract"
  ],
  "kind": "generator",
  "controls": [
    {
      "name": "WAVE_SPEED",
      "label": "WAVE SPEED",
      "description": "When off, the waves will stand still. Could be toggled on the beat to add pulsing to the scene.",
      "group": "motion",
      "type": "float",
      "default": 0,
      "min": -0.2,
      "max": 0,
      "step": 0.2
    },
    {
      "name": "DISTORTION",
      "label": "DISTORTION",
      "description": "Add some smooth distortion to the waves.",
      "group": "motion",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "ROTATE",
      "label": "ROTATE",
      "description": "Add a rotational drift to the waves. Must be reset to perfectly center to get normal waves back.",
      "group": "motion",
      "type": "float",
      "default": 0,
      "min": -0.15,
      "max": 0.15
    },
    {
      "name": "DRIFT",
      "label": "DRIFT",
      "description": "Add a directional drift to the waves. Must be reset to perfectly center to get normal waves back.",
      "group": "motion",
      "type": "float",
      "default": 0,
      "min": -2,
      "max": 2
    },
    {
      "name": "auto_painter",
      "label": "auto painter",
      "description": "When ON, cycles through many different shapes that disturb the wave simulation. When OFF, take manual control using paint position.",
      "group": "painter",
      "type": "float",
      "default": 1,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "paint_position",
      "label": "paint position",
      "description": "auto painter MUST BE OFF. Manually move a small, pulsing paintbrush around the scene, creating a wake as it travels.",
      "group": "painter",
      "type": "point2d",
      "default": [
        0,
        0
      ],
      "min": [
        -1,
        -1
      ],
      "max": [
        1,
        1
      ]
    },
    {
      "name": "logo_type",
      "label": "logo type",
      "description": "Media MUST BE SELECTED. This changes the way the scene treats a user defined image or video. Turn on for flashing, turn off for more subtle masking.",
      "group": "media",
      "type": "float",
      "default": 1,
      "min": 1,
      "max": 1,
      "step": 1
    },
    {
      "name": "config",
      "label": "config",
      "type": "float",
      "default": 1,
      "group": "Transitions"
    },
    {
      "name": "bassconfig",
      "label": "bassconfig",
      "type": "float",
      "default": 0,
      "group": "Transitions"
    },
    {
      "name": "colRegimeSelector",
      "label": "colRegimeSelector",
      "type": "float",
      "default": 2,
      "group": "Transitions"
    }
  ],
  "inputs": [
    {
      "name": "syn_UserImage",
      "type": "image",
      "required": false,
      "sampling": {
        "filter": "linear",
        "wrap": "repeat"
      }
    }
  ],
  "passes": [
    {
      "name": "backbuffer",
      "shader": "main",
      "inputs": [
        {
          "source": "target.backbuffer.previous",
          "uniform": "backbuffer"
        },
        {
          "source": "input.syn_UserImage",
          "uniform": "syn_UserImage"
        }
      ],
      "target": {
        "name": "backbuffer",
        "width": 888,
        "height": 500,
        "format": "rgba32f",
        "sampling": {
          "filter": "linear",
          "wrap": "repeat"
        },
        "persistent": true
      },
      "clear": false
    },
    {
      "name": "final",
      "shader": "main",
      "inputs": [
        {
          "source": "target.backbuffer",
          "uniform": "backbuffer"
        },
        {
          "source": "input.syn_UserImage",
          "uniform": "syn_UserImage"
        }
      ],
      "target": "screen",
      "clear": true
    }
  ],
  "shaders": {
    "glsl": {
      "main": "shaders/main.frag.glsl"
    }
  },
  "compatibility": {
    "source": {
      "format": "ssf",
      "version": "2.0"
    },
    "profile": "ssf/1",
    "mode": "preserve",
    "converter": "blinkfx-ssf-converter/1",
    "controls": {
      "WAVE_SPEED": {
        "format": "ssf",
        "type": "toggle",
        "modifiers": []
      },
      "DISTORTION": {
        "format": "ssf",
        "type": "toggle",
        "modifiers": []
      },
      "ROTATE": {
        "format": "ssf",
        "type": "slider",
        "modifiers": []
      },
      "DRIFT": {
        "format": "ssf",
        "type": "slider",
        "modifiers": []
      },
      "auto_painter": {
        "format": "ssf",
        "type": "toggle",
        "modifiers": []
      },
      "paint_position": {
        "format": "ssf",
        "type": "xy smooth",
        "modifiers": [
          "smooth"
        ],
        "params": 0.05
      },
      "logo_type": {
        "format": "ssf",
        "type": "toggle",
        "modifiers": []
      }
    }
  },
  "license": "Third-party preview: original authors retain all rights; see the author field and source/ directory. Not relicensed by Blink."
}
