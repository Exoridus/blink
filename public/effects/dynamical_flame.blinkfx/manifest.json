{
  "format": "blinkfx/1",
  "id": "com.codexo.ssf.dynamical_flame",
  "title": "Dynamical Flame",
  "author": "cornusammonis",
  "description": "A flaming dynamical system. Click to interact, press spacebar to reset.",
  "thumbnail": "thumbnail.png",
  "tags": [
    "feedback",
    "media",
    "colorful",
    "fluid",
    "simulation"
  ],
  "kind": "generator",
  "controls": [
    {
      "name": "pulsing_fire",
      "label": "pulsing fire",
      "description": "Audio reactive pulses. Turn OFF for constant motion.",
      "group": "reactivity",
      "type": "float",
      "default": 1,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "bass_travel",
      "label": "bass travel",
      "description": "Zoom in on bass hits, creating a feeling of moving forwards.",
      "group": "reactivity",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "media_color_only",
      "label": "media color only",
      "description": "This lets you use the media color only, instead of mixing with the fire.",
      "group": "media",
      "type": "float",
      "default": 1,
      "min": 1,
      "max": 1
    },
    {
      "name": "multiply_color",
      "label": "multiply color",
      "description": "When ON, multiplies the media and fire color, otherwise it is additive.",
      "group": "media",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "media_refract",
      "label": "media refract",
      "description": "Affects how distorted the media is.",
      "group": "media",
      "type": "float",
      "default": 0.4,
      "min": 0,
      "max": 1
    },
    {
      "name": "color_palette",
      "label": "color palette",
      "description": "4 color palettes to choose from on one slider.",
      "group": "color",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 3
    },
    {
      "name": "glassy_surface",
      "label": "glassy surface",
      "description": "Creates a smooth glassy surface. Tipping point is around 70%.",
      "group": "action",
      "type": "float",
      "default": 1,
      "min": 1,
      "max": 1
    },
    {
      "name": "scan_lines",
      "label": "scan lines",
      "description": "Pulses vertical scan lines out from the center.",
      "group": "action",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "ring_of_fire",
      "label": "ring of fire",
      "description": "Spawns a slow moving ring of fire moving out from the center.",
      "group": "action",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "darken",
      "label": "darken",
      "description": "Pulse of darkness across the screen, with fire returning shortly afer.",
      "group": "action",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "fireworks",
      "label": "fireworks",
      "description": "Creates quick burst effects in each cell of the fire.",
      "group": "action",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "reset_sim",
      "label": "reset sim",
      "description": "Only used to reset the simulation if it entirely dies.",
      "group": "reset",
      "type": "float",
      "default": 1,
      "min": 0,
      "max": 1,
      "step": 1
    }
  ],
  "inputs": [
    {
      "name": "syn_Media",
      "type": "image",
      "required": false,
      "sampling": {
        "filter": "mipmap",
        "wrap": "repeat"
      }
    }
  ],
  "assets": [
    {
      "name": "image16",
      "type": "texture2d",
      "path": "assets/16.png",
      "sampling": {
        "filter": "mipmap",
        "wrap": "repeat"
      }
    }
  ],
  "passes": [
    {
      "name": "BuffA",
      "shader": "main",
      "inputs": [
        {
          "source": "target.BuffA.previous",
          "uniform": "BuffA"
        },
        {
          "source": "target.BuffA2.previous",
          "uniform": "BuffA2"
        },
        {
          "source": "asset.image16",
          "uniform": "image16"
        },
        {
          "source": "input.syn_Media",
          "uniform": "syn_Media"
        }
      ],
      "target": {
        "name": "BuffA",
        "width": 1280,
        "height": 720,
        "format": "rgba32f",
        "sampling": {
          "filter": "linear",
          "wrap": "repeat"
        },
        "persistent": true
      },
      "clear": false
    },
    {
      "name": "BuffA2",
      "shader": "main",
      "inputs": [
        {
          "source": "target.BuffA",
          "uniform": "BuffA"
        },
        {
          "source": "target.BuffA2.previous",
          "uniform": "BuffA2"
        },
        {
          "source": "asset.image16",
          "uniform": "image16"
        },
        {
          "source": "input.syn_Media",
          "uniform": "syn_Media"
        }
      ],
      "target": {
        "name": "BuffA2",
        "width": 1280,
        "height": 720,
        "format": "rgba32f",
        "sampling": {
          "filter": "linear",
          "wrap": "repeat"
        },
        "persistent": true
      },
      "clear": false
    },
    {
      "name": "final",
      "shader": "main",
      "inputs": [
        {
          "source": "target.BuffA",
          "uniform": "BuffA"
        },
        {
          "source": "target.BuffA2",
          "uniform": "BuffA2"
        },
        {
          "source": "asset.image16",
          "uniform": "image16"
        },
        {
          "source": "input.syn_Media",
          "uniform": "syn_Media"
        }
      ],
      "target": "screen",
      "clear": true
    }
  ],
  "shaders": {
    "glsl": {
      "main": "shaders/main.frag.glsl"
    }
  },
  "compatibility": {
    "source": {
      "format": "ssf",
      "version": "2.0"
    },
    "profile": "ssf/1",
    "mode": "preserve",
    "converter": "blinkfx-ssf-converter/1",
    "controls": {
      "pulsing_fire": {
        "format": "ssf",
        "type": "toggle",
        "modifiers": []
      },
      "bass_travel": {
        "format": "ssf",
        "type": "toggle",
        "modifiers": []
      },
      "media_color_only": {
        "format": "ssf",
        "type": "slider",
        "modifiers": []
      },
      "multiply_color": {
        "format": "ssf",
        "type": "toggle",
        "modifiers": []
      },
      "media_refract": {
        "format": "ssf",
        "type": "slider smooth",
        "modifiers": [
          "smooth"
        ],
        "params": 0.1
      },
      "color_palette": {
        "format": "ssf",
        "type": "slider",
        "modifiers": []
      },
      "glassy_surface": {
        "format": "ssf",
        "type": "slider",
        "modifiers": []
      },
      "scan_lines": {
        "format": "ssf",
        "type": "bang smooth",
        "modifiers": [
          "smooth"
        ],
        "params": 0.05
      },
      "ring_of_fire": {
        "format": "ssf",
        "type": "bang smooth",
        "modifiers": [
          "smooth"
        ],
        "params": 0.0025
      },
      "darken": {
        "format": "ssf",
        "type": "bang smooth",
        "modifiers": [
          "smooth"
        ],
        "params": 0.5
      },
      "fireworks": {
        "format": "ssf",
        "type": "bang smooth",
        "modifiers": [
          "smooth"
        ],
        "params": 0.1
      },
      "reset_sim": {
        "format": "ssf",
        "type": "bang",
        "modifiers": []
      }
    }
  },
  "license": "Third-party preview: original authors retain all rights; see the author field and source/ directory. Not relicensed by Blink."
}
