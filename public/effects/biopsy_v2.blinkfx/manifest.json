      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "left_sweep",
      "label": "left sweep",
      "description": "Send a sweep through the simulation.",
      "group": "sweep",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1,
      "step": 1
