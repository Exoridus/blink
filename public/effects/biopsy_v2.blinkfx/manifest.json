      "type": "float",
      "default": 0.1,
      "min": 0,
      "max": 1
    },
    {
      "name": "down_sweep",
      "label": "down sweep",
      "description": "Send a sweep through the simulation.",
      "group": "sweep",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "up_sweep",
      "label": "up sweep",
      "description": "Send a sweep through the simulation.",
