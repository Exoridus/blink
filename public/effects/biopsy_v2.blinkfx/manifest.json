      "name": "inOrOut",
      "label": "inOrOut",
      "type": "float",
      "default": 1,
      "group": "Transitions"
    },
    {
      "name": "mode",
      "label": "mode",
      "type": "float",
      "default": 1,
      "group": "Transitions"
    }
