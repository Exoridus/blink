{
  "format": "blinkfx/1",
  "id": "com.codexo.ssf.biopsy_v2",
  "title": "Biopsy_V2",
  "author": "Meebs ft. Flexi",
  "thumbnail": "thumbnail.png",
  "tags": [
    "simulation",
    "feedback",
    "abstract",
    "media",
    "reaction-diffusion"
  ],
  "kind": "generator",
  "controls": [
    {
      "name": "drips",
      "label": "drips",
      "description": "Changes the simulation to make it more drippy.",
      "group": "motion",
      "type": "float",
      "default": 1,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "slicing",
      "label": "slicing",
      "description": "Automatically slice the simulation on the beats in the music.",
      "group": "motion",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "stretching",
      "label": "stretching",
      "description": "Vertical and horizontal stretching in time with the music.",
      "group": "motion",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "distort",
      "label": "distort",
      "description": "Adds a slow lens distortion. Add vertical or horizontal mirrors for best effect.",
      "group": "motion",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "in_or_out",
      "label": "in or out",
      "group": "motion",
      "type": "float",
      "default": 1,
      "min": 1,
      "max": 1
    },
    {
      "name": "circle_on",
      "label": "circle on",
      "description": "If on, only center circle will be 'fiery'.",
      "group": "circle",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "circle_size",
      "label": "circle size",
      "description": "Size of center circle.",
      "group": "circle",
      "type": "float",
      "default": 0,
      "min": -0.3,
      "max": 1
    },
    {
      "name": "color_palette",
      "label": "color palette",
      "description": "Choose from one of three color palettes.",
      "group": "color",
      "type": "float",
      "default": 1,
      "min": 0,
      "max": 2
    },
    {
      "name": "flashing",
      "label": "flashing",
      "description": "Flash yellow on high hits.",
      "group": "color",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "no_shading",
      "label": "no shading",
      "description": "Default scene has a darker, subtly audio reactive shading. Turn this up to use full-color, no shading.",
