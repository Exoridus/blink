{
  "format": "blinkfx/1",
  "id": "com.codexo.ssf.inkshot",
  "title": "Ink Shot",
  "author": "Meebs",
  "thumbnail": "thumbnail.jpg",
  "tags": [
    "glitchy",
    "media",
    "2d",
    "psychedelic",
    "colorful"
  ],
  "kind": "generator",
  "controls": [
    {
      "name": "auto_jumper",
      "label": "auto jumper",
      "description": "Automatically jumps to a new background location on percussive beats. Turn off for full manual control.",
      "group": "jump",
      "type": "float",
      "default": 1,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "jump",
      "label": "jump",
      "description": "Press to manually jump to a new background location.",
      "group": "jump",
      "type": "float",
      "default": 1,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "auto_pulse",
      "label": "auto pulse",
      "description": "Automatically pulses on bass hits. Turn off for full manual control.",
      "group": "pulse",
      "type": "float",
      "default": 1,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "pulse",
      "label": "pulse",
      "description": "Press to manually create a pulse.",
      "group": "pulse",
      "type": "float",
      "default": 1,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "pulse_intensity",
      "label": "pulse intensity",
      "description": "Control the intensity of the pulse. Lower for subtle, high for a lot of motion.",
      "group": "pulse",
      "type": "float",
      "default": 1,
      "min": 0,
      "max": 2
    },
    {
      "name": "contrast",
      "label": "contrast",
      "description": "Turn on to increase contrast. Less uniform and more distinct dots. Try with pulse intensity on high and slices ON.",
      "group": "effects",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "slices",
      "label": "slices",
      "description": "Slices up the screen. Turn on, then turn pulse intensity up for a cool splitting effect.",
      "group": "effects",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "whichTwoColors",
      "label": "whichTwoColors",
      "type": "float",
      "default": 0,
      "group": "Transitions"
    }
  ],
  "inputs": [
    {
      "name": "syn_Media",
      "type": "image",
      "required": false,
      "sampling": {
        "filter": "linear",
        "wrap": "repeat"
      }
    },
    {
      "name": "syn_UserImage",
      "type": "image",
      "required": false,
      "sampling": {
        "filter": "linear",
        "wrap": "repeat"
      }
    }
  ],
  "passes": [
    {
      "name": "forRGBSplit",
      "shader": "main",
      "inputs": [
        {
          "source": "target.forRGBSplit.previous",
          "uniform": "forRGBSplit"
        },
        {
          "source": "input.syn_Media",
          "uniform": "syn_Media"
        },
        {
          "source": "input.syn_UserImage",
          "uniform": "syn_UserImage"
        }
      ],
      "target": {
        "name": "forRGBSplit",
        "format": "rgba8",
        "sampling": {
          "filter": "linear",
          "wrap": "repeat"
        },
        "persistent": true
      },
      "clear": false
    },
    {
      "name": "final",
      "shader": "main",
      "inputs": [
        {
          "source": "target.forRGBSplit",
          "uniform": "forRGBSplit"
        },
        {
          "source": "input.syn_Media",
          "uniform": "syn_Media"
        },
        {
          "source": "input.syn_UserImage",
          "uniform": "syn_UserImage"
        }
      ],
      "target": "screen",
      "clear": true
    }
  ],
  "shaders": {
    "glsl": {
      "main": "shaders/main.frag.glsl"
    }
  },
  "compatibility": {
    "source": {
      "format": "ssf",
      "version": "2.0"
    },
    "profile": "ssf/1",
    "mode": "preserve",
    "converter": "blinkfx-ssf-converter/1",
    "controls": {
      "auto_jumper": {
        "format": "ssf",
        "type": "toggle",
        "modifiers": []
      },
      "jump": {
        "format": "ssf",
        "type": "bang counter",
        "modifiers": [
          "counter"
        ]
      },
      "auto_pulse": {
        "format": "ssf",
        "type": "toggle",
        "modifiers": []
      },
      "pulse": {
        "format": "ssf",
        "type": "bang smooth",
        "modifiers": [
          "smooth"
        ],
        "params": 0.05
      },
      "pulse_intensity": {
        "format": "ssf",
        "type": "slider smooth",
        "modifiers": [
          "smooth"
        ],
        "params": 0.05
      },
      "contrast": {
        "format": "ssf",
        "type": "toggle",
        "modifiers": []
      },
      "slices": {
        "format": "ssf",
        "type": "toggle",
        "modifiers": []
      }
    }
  },
  "license": "Third-party preview: original authors retain all rights; see the author field and source/ directory. Not relicensed by Blink."
}
