          "filter": "linear",
          "wrap": "repeat"
        },
        "persistent": true
      },
      "clear": false
    },
    {
      "name": "secondPass",
      "shader": "main",
      "inputs": [
        {
          "source": "target.firstPass",
          "uniform": "firstPass"
        },
        {
          "source": "target.postFXPass",
          "uniform": "postFXPass"
        },
        {
          "source": "target.secondPass.previous",
          "uniform": "secondPass"
        },
        {
          "source": "target.rVertMirrPass.previous",
          "uniform": "rVertMirrPass"
        },
        {
          "source": "input.syn_UserImage",
          "uniform": "syn_UserImage"
        },
        {
          "source": "target.syn_FinalBuffer.previous",
          "uniform": "syn_FinalPass"
        }
      ],
      "target": {
        "name": "secondPass",
        "width": 1920,
        "height": 1080,
        "format": "rgba32f",
        "sampling": {
          "filter": "linear",
          "wrap": "repeat"
        },
        "persistent": true
      },
      "clear": false
    },
    {
      "name": "rVertMirrPass",
      "shader": "main",
      "inputs": [
        {
          "source": "target.firstPass",
          "uniform": "firstPass"
        },
        {
          "source": "target.postFXPass",
          "uniform": "postFXPass"
        },
        {
          "source": "target.secondPass",
          "uniform": "secondPass"
        },
        {
          "source": "target.rVertMirrPass.previous",
          "uniform": "rVertMirrPass"
        },
        {
          "source": "input.syn_UserImage",
          "uniform": "syn_UserImage"
        },
        {
          "source": "target.syn_FinalBuffer.previous",
          "uniform": "syn_FinalPass"
        }
      ],
      "target": {
        "name": "rVertMirrPass",
        "width": 1920,
        "height": 1080,
        "format": "rgba32f",
        "sampling": {
          "filter": "linear",
          "wrap": "repeat"
        },
        "persistent": true
      },
      "clear": false
    },
    {
      "name": "main",
      "shader": "main",
      "inputs": [
        {
          "source": "target.firstPass",
          "uniform": "firstPass"
        },
        {
          "source": "target.postFXPass",
          "uniform": "postFXPass"
        },
        {
          "source": "target.secondPass",
          "uniform": "secondPass"
        },
        {
          "source": "target.rVertMirrPass",
          "uniform": "rVertMirrPass"
        },
        {
          "source": "input.syn_UserImage",
          "uniform": "syn_UserImage"
        },
        {
          "source": "target.syn_FinalBuffer.previous",
          "uniform": "syn_FinalPass"
        }
      ],
      "target": {
        "name": "syn_FinalBuffer",
        "format": "rgba8",
        "persistent": true
      },
      "clear": true
    },
    {
      "name": "present",
      "shader": "present",
      "inputs": [
        {
          "source": "target.syn_FinalBuffer",
          "uniform": "present_source"
        }
      ],
      "target": "screen",
      "clear": true
    }
  ],
  "shaders": {
    "glsl": {
      "main": "shaders/main.frag.glsl",
