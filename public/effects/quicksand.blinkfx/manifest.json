{
  "format": "blinkfx/1",
  "id": "com.codexo.ssf.quicksand",
  "title": "Quicksand",
  "author": "Meebs",
  "thumbnail": "thumbnail.png",
  "tags": [
    "feedback",
    "media",
    "glitchy",
    "fluid"
  ],
  "kind": "generator",
  "controls": [
    {
      "name": "pusher",
      "label": "pusher",
      "description": "When ON, Percussive hits will cause the the simulation to 'burst'.",
      "group": "action",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "scroller",
      "label": "scroller",
      "description": "When ON, the actiion is replaced with diagonal scrolling, oscillating on the beat. Leads to interesting contour lines and more 'echoes'.",
      "group": "action",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "soften",
      "label": "soften",
      "description": "Removes hard edges, resulting on a softer 'smokey' look.",
      "group": "effects",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "monochrome",
      "label": "monochrome",
      "description": "Turn on for a vertically scrolling stark black and white scene. Good for dramatic parts of the music. Try turning soften and scroller on and off while monochrome is ON.",
      "group": "effects",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "vert_speed",
      "label": "vert speed",
      "description": "Move the simulation twice as fast vertically when ON. Very subtle effect.",
      "group": "speed",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "hor_speed",
      "label": "hor speed",
      "description": "Move the simulation twice as fast horizontally when ON. Very subtle effect.",
      "group": "speed",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "name": "shape_type",
      "label": "shape type",
      "type": "float",
      "default": 1,
      "group": "Transitions"
    },
    {
      "name": "scanDirection",
      "label": "scanDirection",
      "type": "float",
      "default": 0,
      "group": "Transitions"
    },
    {
      "name": "colorMode",
      "label": "colorMode",
      "type": "float",
      "default": 0,
      "group": "Transitions"
    },
    {
      "name": "cReg0",
      "label": "cReg0",
      "type": "float",
      "default": 1,
      "group": "Transitions"
    },
    {
      "name": "cReg1",
      "label": "cReg1",
      "type": "float",
      "default": 0,
      "group": "Transitions"
    },
    {
      "name": "cReg2",
      "label": "cReg2",
      "type": "float",
      "default": 0,
      "group": "Transitions"
    }
  ],
  "inputs": [
    {
      "name": "syn_Media",
      "type": "image",
      "required": false,
      "sampling": {
        "filter": "linear",
        "wrap": "repeat"
      }
    },
    {
      "name": "syn_UserImage",
      "type": "image",
      "required": false,
      "sampling": {
        "filter": "linear",
        "wrap": "repeat"
      }
    }
  ],
  "passes": [
    {
      "name": "firstBuff",
      "shader": "main",
      "inputs": [
        {
          "source": "target.firstBuff.previous",
          "uniform": "firstBuff"
        },
        {
          "source": "target.secondBuff.previous",
          "uniform": "secondBuff"
        },
        {
          "source": "input.syn_Media",
          "uniform": "syn_Media"
        },
        {
          "source": "input.syn_UserImage",
          "uniform": "syn_UserImage"
        }
      ],
      "target": {
        "name": "firstBuff",
        "format": "rgba32f",
        "sampling": {
          "filter": "linear",
          "wrap": "repeat"
        },
        "persistent": true
      },
      "clear": false
    },
    {
      "name": "secondBuff",
      "shader": "main",
      "inputs": [
        {
          "source": "target.firstBuff",
          "uniform": "firstBuff"
        },
        {
          "source": "target.secondBuff.previous",
          "uniform": "secondBuff"
        },
        {
          "source": "input.syn_Media",
          "uniform": "syn_Media"
        },
        {
          "source": "input.syn_UserImage",
          "uniform": "syn_UserImage"
        }
      ],
      "target": {
        "name": "secondBuff",
        "format": "rgba32f",
        "sampling": {
          "filter": "linear",
          "wrap": "repeat"
        },
        "persistent": true
      },
      "clear": false
    },
    {
      "name": "final",
      "shader": "main",
      "inputs": [
        {
          "source": "target.firstBuff",
          "uniform": "firstBuff"
        },
        {
          "source": "target.secondBuff",
          "uniform": "secondBuff"
        },
        {
          "source": "input.syn_Media",
          "uniform": "syn_Media"
        },
        {
          "source": "input.syn_UserImage",
          "uniform": "syn_UserImage"
        }
      ],
      "target": "screen",
      "clear": true
    }
  ],
  "shaders": {
    "glsl": {
      "main": "shaders/main.frag.glsl"
    }
  },
  "compatibility": {
    "source": {
      "format": "ssf",
      "version": "2.0"
    },
    "profile": "ssf/1",
    "mode": "preserve",
    "converter": "blinkfx-ssf-converter/1",
    "controls": {
      "pusher": {
        "format": "ssf",
        "type": "toggle",
        "modifiers": []
      },
      "scroller": {
        "format": "ssf",
        "type": "toggle",
        "modifiers": []
      },
      "soften": {
        "format": "ssf",
        "type": "toggle",
        "modifiers": []
      },
      "monochrome": {
        "format": "ssf",
        "type": "toggle smooth",
        "modifiers": [
          "smooth"
        ],
        "params": 0.02
      },
      "vert_speed": {
        "format": "ssf",
        "type": "toggle",
        "modifiers": []
      },
      "hor_speed": {
        "format": "ssf",
        "type": "toggle",
        "modifiers": []
      }
    }
  },
  "license": "Third-party preview: original authors retain all rights; see the author field and source/ directory. Not relicensed by Blink."
}
