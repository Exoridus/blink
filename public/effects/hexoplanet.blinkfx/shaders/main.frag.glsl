  dstepf = 0.0;
  bassBump = (clamp(syn_BassLevel, 0.25, 1.0)-0.25)*1.5;
  bumpAction = mix(bassBump*bassBump, syn_ToggleOnBeat, bass_bump);
  fragColor = renderMain();
}
