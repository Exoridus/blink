{
  "format": "blinkfx/1",
  "id": "com.codexo.ssf.pop",
  "title": "Pop",
  "author": "Meebs",
  "thumbnail": "thumbnail.jpg",
  "tags": [
    "2d",
    "colorful",
    "retro"
  ],
  "kind": "generator",
  "controls": [
    {
      "name": "dither_mod",
      "label": "dither mod",
      "description": "Affects the dither. Low will be fewer bright pixels, high will be no dithering at all.",
      "group": "pixels",
      "type": "float",
      "default": 0.75,
      "min": 0.1,
      "max": 2
    },
    {
      "name": "size",
      "label": "size",
      "description": "Sets the size of the pixels for the dither effect.",
      "group": "pixels",
      "type": "float",
      "default": 2.4,
      "min": 0.75,
      "max": 8
    },
    {
      "name": "pattern_mixer",
      "label": "pattern mixer",
      "description": "Mixes between two patterns: low is the simple shapes, high is the smooth gradient shape with lots of motion.",
      "group": "pattern",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1
    },
    {
      "name": "color_1",
      "label": "color 1",
      "description": "Define one of the two colors that make up the palette.",
      "group": "color",
      "type": "color",
      "default": [
        0.3,
        0.6,
        0.8,
        1
      ]
    },
    {
      "name": "color_2",
      "label": "color 2",
      "description": "Define the second color. Most colors will fall between these two, but will always be more heavily saturated.",
      "group": "color",
      "type": "color",
      "default": [
        1,
        0.8,
        0.2,
        1
      ]
    },
    {
      "name": "direction",
      "label": "direction",
      "type": "float",
      "default": -1,
      "group": "Transitions"
    },
    {
      "name": "sides",
      "label": "sides",
      "type": "float",
      "default": 1,
      "group": "Transitions"
    },
    {
      "name": "colRegime",
      "label": "colRegime",
      "type": "float",
      "default": 0,
      "group": "Transitions"
    }
  ],
  "inputs": [
    {
      "name": "syn_Media",
      "type": "image",
      "required": false,
      "sampling": {
        "filter": "linear",
        "wrap": "repeat"
      }
    }
  ],
  "passes": [
    {
      "name": "firstBuffer",
      "shader": "main",
      "inputs": [
        {
          "source": "input.syn_Media",
          "uniform": "syn_Media"
        }
      ],
      "target": {
        "name": "firstBuffer",
        "format": "rgba32f",
        "sampling": {
          "filter": "linear",
          "wrap": "repeat"
        },
        "persistent": true
      },
      "clear": false
    },
    {
      "name": "secondBuffer",
      "shader": "main",
      "inputs": [
        {
          "source": "input.syn_Media",
          "uniform": "syn_Media"
        }
      ],
      "target": {
        "name": "secondBuffer",
        "format": "rgba32f",
        "sampling": {
          "filter": "linear",
          "wrap": "repeat"
        },
        "persistent": true
      },
      "clear": false
    },
    {
      "name": "final",
      "shader": "main",
      "inputs": [
        {
          "source": "input.syn_Media",
          "uniform": "syn_Media"
        }
      ],
      "target": "screen",
      "clear": true
    }
  ],
  "shaders": {
    "glsl": {
      "main": "shaders/main.frag.glsl"
    }
  },
  "compatibility": {
    "source": {
      "format": "ssf",
      "version": "2.0"
    },
    "profile": "ssf/1",
    "mode": "preserve",
    "converter": "blinkfx-ssf-converter/1",
    "controls": {
      "dither_mod": {
        "format": "ssf",
        "type": "slider",
        "modifiers": []
      },
      "size": {
        "format": "ssf",
        "type": "slider",
        "modifiers": []
      },
      "pattern_mixer": {
        "format": "ssf",
        "type": "slider",
        "modifiers": []
      },
      "color_1": {
        "format": "ssf",
        "type": "color",
        "modifiers": []
      },
      "color_2": {
        "format": "ssf",
        "type": "color",
        "modifiers": []
      }
    }
  },
  "license": "Third-party preview: original authors retain all rights; see the author field and source/ directory. Not relicensed by Blink."
}
