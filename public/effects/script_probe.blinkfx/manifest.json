{
  "format": "blinkfx/1",
  "id": "com.codexo.script_probe",
  "title": "Script Probe",
  "author": "DIMA",
  "description": "Exercises the blink/1 script ABI, presets and declared requirements.",
  "license": "MIT",
  "tags": ["probe", "script", "presets"],
  "controls": [
    {
      "name": "level",
      "label": "Level",
      "type": "float",
      "default": 0.0,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "group": "Script"
    },
    {
      "name": "gate",
      "label": "Gate",
      "type": "bool",
      "default": false,
      "group": "Script"
    },
    {
      "name": "tint",
      "label": "Tint",
      "type": "color",
      "default": [0.2, 0.7, 1.0, 1.0],
      "group": "Color"
    }
  ],
  "outputs": { "visual": true },
  "requirements": {
    "features": ["script:blink/1"],
    "backends": ["webgl2"]
  },
  "shaders": {
    "glsl": "shaders/main.frag.glsl"
  },
  "presets": [
    { "name": "calm", "path": "presets/calm.json" },
    { "name": "hot", "path": "presets/hot.json" }
  ],
  "script": {
    "entry": "scripts/main.js",
    "abi": "blink/1",
    "events": [
      { "input": "gate", "on": "offToOn", "handler": "onGateOpened" },
      { "input": "gate", "on": "onToOff", "handler": "onGateClosed" }
    ]
  }
}
