  return uv + shaker * amount;
}

vec4 renderMain() {
  if (PASSINDEX == 0){
  	vec2 uv = _uvc;
    uv = mix(uv, uv*1.7, r3);
  	// uv += (vec2(sin(cameratime), cos(cameratime+1000)) - 0.5)*0.25;
    uv = shakeUV(uv);

  	vec3 rd = normalize(vec3(uv.x, uv.y, 3.1415926535898/8.0));

