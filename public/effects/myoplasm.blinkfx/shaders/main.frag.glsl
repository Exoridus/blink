  	float c = voronoi(rd*2.0);

  	c = max(c + dot(hash(rd)*2.-1., vec3(0.015)), 0.);

    c *= sqrt(c)*(1.5 + r3);
    vec3 col = palette(c);

    col = mix(1.0 - col, col, round(n3 + n2));

    if (color_mode > 0.5){
      col = 1.0-(col-(dFdx(col)+dFdy(col))*10.0);
    }

